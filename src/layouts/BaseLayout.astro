---
import "~/styles/global.css";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import WashiTexture from "~/components/WashiTexture.astro";
import Analytics from "@vercel/analytics/astro";

export interface Props {
  title: string;
  description?: string;
  /** OG/Twitter image. Defaults to /og-image.png. */
  ogImage?: string;
  /** Hides the footer signature on pages that shouldn't have it (none currently). */
  hideSignature?: boolean;
  /** Adds a class to <body> so per-page features can scope styles or scripts. */
  bodyClass?: string;
}

const {
  title,
  description = "Stats and computing at Waterloo. Seven CAS exams in, on track for FCAS. Thinking about where actuarial work meets modern technology.",
  ogImage = "/og-image.png",
  hideSignature = false,
  bodyClass = "",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
const buildDate = import.meta.env.BUILD_DATE ?? "—";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!--
      Fonts (pi.website-style pairing):
        Newsreader - display serif for h1 (William Zhang), section labels,
                     note titles. Closest Google Fonts match to Signifier
                     (Klim, commercial), which pi.website licenses.
        Caveat     - signature + in-game text in the badminton canvas
      Body text is the same system monospace stack pi.website uses; no
      webfont needed for it.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=Caveat:wght@500;600&display=swap"
    />
  </head>
  <body class={bodyClass} data-build-date={buildDate}>
    <main class="paper">
      <WashiTexture />
      <Nav />
      <slot />
      <Footer hideSignature={hideSignature} buildDate={buildDate} />
    </main>
    <Analytics />
  </body>
</html>
