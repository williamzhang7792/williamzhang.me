---
import BaseLayout from "~/layouts/BaseLayout.astro";
import ReadingProgress from "~/components/ReadingProgress.astro";
import { formatDate } from "~/lib/formatDate";

export interface Props {
  title: string;
  description: string;
  date: Date;
  upcoming?: boolean;
}

const { title, description, date, upcoming = false } = Astro.props;
---

<BaseLayout title={`${title} — William Zhang`} description={description} bodyClass="note-page">
  <ReadingProgress />

  <a href="/notes/" class="note-back-top link-underline" aria-label="All notes">←</a>

  <article class="note">
    <header class="note-header">
      <h1 class="note-title">{title}</h1>
      <p class="note-date">{upcoming ? "upcoming" : formatDate(date)}</p>
    </header>

    <div class="note-body">
      <slot />
    </div>
  </article>

  <p class="back back--collapsed">
    <a href="/notes/" class="link-underline back-link">← all notes</a>
  </p>
</BaseLayout>

<style>
  .note-header {
    margin-bottom: 32px;
  }

  .note-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 28px;
    color: var(--accent);
    margin: 0 0 8px 0;
    line-height: 1.25;
  }

  .note-date {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
    margin: 0;
    letter-spacing: 0.02em;
  }

  /* Note body — Source Serif 4 (inherited from html), bumped to 17px since
     long-form reading benefits from slightly larger text than the dense
     about page. */
  .note-body {
    font-size: 17px;
    line-height: 1.7;
  }

  .note-body :global(p) {
    margin: 0 0 1em 0;
  }

  .note-body :global(h2) {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: 22px;
    color: var(--accent);
    margin: 2em 0 0.5em 0;
  }

  .note-body :global(h3) {
    font-size: 18px;
    font-weight: 600;
    margin: 1.5em 0 0.5em 0;
    color: var(--text-body);
  }

  .note-body :global(h4) {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 17px;
    font-weight: 500;
    margin: 1.4em 0 0.3em 0;
    color: var(--text-muted);
  }

  .note-body :global(strong) {
    font-weight: 700;
    color: var(--text-body);
  }

  .note-body :global(em) {
    font-style: italic;
  }

  /* Inline links inside note prose: subtle persistent underline at low
     opacity, hover bumps to opaque. Differs from .link-strong in that body
     prose links shouldn't shout. */
  .note-body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
    transition: text-decoration-color var(--transition-base);
  }

  .note-body :global(a:hover),
  .note-body :global(a:focus-visible) {
    text-decoration-color: var(--accent);
    outline: none;
  }

  .note-body :global(ul),
  .note-body :global(ol) {
    margin: 1em 0;
    padding-left: 1.4em;
  }

  .note-body :global(li) {
    margin: 0.4em 0;
  }

  /* Tight nested paragraphs inside list items. */
  .note-body :global(li) :global(p) {
    margin: 0;
  }

  .note-body :global(blockquote) {
    margin: 1.5em 0;
    padding-left: 18px;
    border-left: 2px solid var(--border-subtle);
    color: var(--text-muted);
    font-style: italic;
  }

  .note-body :global(hr) {
    border: 0;
    border-top: 1px solid var(--border-subtle);
    margin: 2.5em 0;
  }

  .note-body :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 1.5em auto;
    border-radius: 2px;
  }

  .note-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5em 0;
    font-size: 0.95em;
  }

  .note-body :global(th),
  .note-body :global(td) {
    text-align: left;
    padding: 0.5em 0.8em;
    border-bottom: 1px solid var(--border-subtle);
    vertical-align: top;
  }

  .note-body :global(th) {
    font-weight: 700;
    color: var(--text-body);
  }

  .note-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.92em;
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    padding: 0.1em 0.3em;
    border-radius: 2px;
  }

  .note-body :global(pre) {
    font-family: var(--font-mono);
    font-size: 14px;
    background: color-mix(in srgb, var(--text-body) 4%, transparent);
    padding: 14px 16px;
    border-radius: 4px;
    overflow-x: auto;
    line-height: 1.5;
  }

  .note-body :global(pre code) {
    background: none;
    padding: 0;
  }

  .note-body :global(.mermaid-diagram) {
    margin: 1.8em auto;
    max-width: 100%;
    overflow-x: auto;
    text-align: center;
  }

  .note-body :global(.mermaid-diagram svg) {
    max-width: 100%;
    height: auto;
  }

  /* Top-right back — arrow only; scrolls with page (not fixed). */
  .note-back-top {
    position: absolute;
    top: 32px;
    right: 60px;
    z-index: 2;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 15px;
    color: var(--text-muted);
    text-decoration: none;
  }

  .note-back-top:hover,
  .note-back-top:focus-visible {
    color: var(--accent);
    outline: none;
  }

  @media (max-width: 720px) {
    .note-back-top {
      right: 24px;
    }
  }

  .back {
    margin-top: 48px;
    font-style: italic;
  }

  .back.back--collapsed {
    display: none;
  }

  .back-link {
    color: var(--text-muted);
  }
</style>

<script>
  const updateBackVisibility = () => {
    const topBack = document.querySelector(".note-back-top");
    const bottomBack = document.querySelector(".back");
    if (!topBack || !bottomBack) return;

    const gap = bottomBack.offsetTop - topBack.offsetTop;
    const showBottom = gap > window.innerHeight;
    bottomBack.classList.toggle("back--collapsed", !showBottom);
  };

  let backTicking = false;
  const scheduleBackVisibility = () => {
    if (!backTicking) {
      requestAnimationFrame(() => {
        updateBackVisibility();
        backTicking = false;
      });
      backTicking = true;
    }
  };

  scheduleBackVisibility();
  window.addEventListener("resize", scheduleBackVisibility, { passive: true });

  const mermaidPres = document.querySelectorAll('pre[data-language="mermaid"]');
  const mermaidCodes = document.querySelectorAll("pre code.language-mermaid");
  const hasMermaid = mermaidPres.length > 0 || mermaidCodes.length > 0;

  if (hasMermaid) {
    const mermaid = (await import("mermaid")).default;

    const css = getComputedStyle(document.documentElement);
    const tok = (n: string) => css.getPropertyValue(n).trim();

    mermaid.initialize({
      startOnLoad: false,
      theme: "base",
      themeVariables: {
        background: tok("--bg-paper"),
        primaryColor: tok("--bg-paper"),
        primaryTextColor: tok("--text-body"),
        primaryBorderColor: tok("--accent"),
        lineColor: tok("--text-muted"),
        secondaryColor: tok("--bg-outer"),
        tertiaryColor: tok("--bg-paper"),
        secondaryTextColor: tok("--text-body"),
        tertiaryTextColor: tok("--text-body"),
        nodeBorder: tok("--accent"),
        clusterBkg: "transparent",
        clusterBorder: tok("--border-subtle"),
        edgeLabelBackground: tok("--bg-paper"),
        fontFamily: "Source Serif 4, Georgia, serif",
        fontSize: "15px",
      },
    });

    const renderBlock = async (code: string, replaceEl: Element, index: number) => {
      const id = `mmd-${index}-${Date.now()}`;
      const wrap = document.createElement("div");
      wrap.className = "mermaid-diagram";
      replaceEl.replaceWith(wrap);
      try {
        const { svg } = await mermaid.render(id, code);
        wrap.innerHTML = svg;
      } catch {
        wrap.textContent = "(mermaid render error)";
      }
    };

    let index = 0;
    for (const pre of mermaidPres) {
      await renderBlock(pre.textContent ?? "", pre, index++);
    }

    for (const block of mermaidCodes) {
      const code = block.textContent ?? "";
      const parent = block.parentElement;
      if (parent) await renderBlock(code, parent, index++);
    }

    scheduleBackVisibility();
  }
</script>
