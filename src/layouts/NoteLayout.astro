---
import BaseLayout from "~/layouts/BaseLayout.astro";
import ReadingProgress from "~/components/ReadingProgress.astro";

export interface Props {
  title: string;
  description: string;
  date: Date;
}

const { title, description, date } = Astro.props;

const formatLong = (d: Date) =>
  d.toLocaleDateString("en-CA", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title={`${title} — William Zhang`} description={description} bodyClass="note-page">
  <ReadingProgress />

  <article class="note">
    <header class="note-header">
      <h1 class="note-title">{title}</h1>
      <p class="note-date">{formatLong(date)}</p>
    </header>

    <div class="note-body">
      <slot />
    </div>
  </article>

  <p class="back">
    <a href="/notes/" class="link-underline back-link">← all notes</a>
  </p>
</BaseLayout>

<style>
  .note-header {
    margin-bottom: 32px;
  }

  .note-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 28px;
    color: var(--accent);
    margin: 0 0 8px 0;
    line-height: 1.25;
  }

  .note-date {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
    margin: 0;
    letter-spacing: 0.02em;
  }

  /* Note body — Source Serif 4 (inherited from html), bumped to 17px since
     long-form reading benefits from slightly larger text than the dense
     about page. */
  .note-body {
    font-size: 17px;
    line-height: 1.7;
  }

  .note-body :global(p) {
    margin: 0 0 1em 0;
  }

  .note-body :global(h2) {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: 22px;
    color: var(--accent);
    margin: 2em 0 0.5em 0;
  }

  .note-body :global(h3) {
    font-size: 18px;
    font-weight: 600;
    margin: 1.5em 0 0.5em 0;
    color: var(--text-body);
  }

  .note-body :global(h4) {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 17px;
    font-weight: 500;
    margin: 1.4em 0 0.3em 0;
    color: var(--text-muted);
  }

  .note-body :global(strong) {
    font-weight: 700;
    color: var(--text-body);
  }

  .note-body :global(em) {
    font-style: italic;
  }

  /* Inline links inside note prose: subtle persistent underline at low
     opacity, hover bumps to opaque. Differs from .link-strong in that body
     prose links shouldn't shout. */
  .note-body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
    transition: text-decoration-color var(--transition-base);
  }

  .note-body :global(a:hover),
  .note-body :global(a:focus-visible) {
    text-decoration-color: var(--accent);
    outline: none;
  }

  .note-body :global(ul),
  .note-body :global(ol) {
    margin: 1em 0;
    padding-left: 1.4em;
  }

  .note-body :global(li) {
    margin: 0.4em 0;
  }

  /* Tight nested paragraphs inside list items. */
  .note-body :global(li) :global(p) {
    margin: 0;
  }

  .note-body :global(blockquote) {
    margin: 1.5em 0;
    padding-left: 18px;
    border-left: 2px solid var(--border-subtle);
    color: var(--text-muted);
    font-style: italic;
  }

  .note-body :global(hr) {
    border: 0;
    border-top: 1px solid var(--border-subtle);
    margin: 2.5em 0;
  }

  .note-body :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 1.5em auto;
    border-radius: 2px;
  }

  .note-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5em 0;
    font-size: 0.95em;
  }

  .note-body :global(th),
  .note-body :global(td) {
    text-align: left;
    padding: 0.5em 0.8em;
    border-bottom: 1px solid var(--border-subtle);
    vertical-align: top;
  }

  .note-body :global(th) {
    font-weight: 700;
    color: var(--text-body);
  }

  .note-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.92em;
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    padding: 0.1em 0.3em;
    border-radius: 2px;
  }

  .note-body :global(pre) {
    font-family: var(--font-mono);
    font-size: 14px;
    background: color-mix(in srgb, var(--text-body) 4%, transparent);
    padding: 14px 16px;
    border-radius: 4px;
    overflow-x: auto;
    line-height: 1.5;
  }

  .note-body :global(pre code) {
    background: none;
    padding: 0;
  }

  .back {
    margin-top: 48px;
    font-style: italic;
  }

  .back-link {
    color: var(--text-muted);
  }
</style>
