---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { formatDate } from "~/lib/formatDate";

const all = await getCollection("notes");
const isProd = import.meta.env.PROD;
const notes = all
  .filter((entry) => !isProd || !entry.data.draft)
  .sort((a, b) => {
    if (a.data.upcoming !== b.data.upcoming) {
      return a.data.upcoming ? 1 : -1;
    }
    return b.data.date.valueOf() - a.data.date.valueOf();
  });
---

<BaseLayout
  title="notes — William Zhang"
  description="Half-formed thoughts on actuarial work, AI risk, and modern technology. By William Zhang."
  bodyClass="notes-index"
>
  <header class="notes-header">
    <h1 class="page-label">notes</h1>
    <p class="subtitle">half-formed thoughts with sporadic updates.</p>
  </header>

  {notes.length === 0 ? (
    <p class="empty">first piece coming soon.</p>
  ) : (
    <ol class="note-list">
      {notes.map((entry) => (
        <li class="note-row">
          <a href={`/notes/${entry.id}/`} class="note-link">
            <span class="note-date">
              {entry.data.upcoming ? "upcoming" : formatDate(entry.data.date)}
            </span>
            <span class="note-title link-underline">{entry.data.title}</span>
          </a>
        </li>
      ))}
    </ol>
  )}
</BaseLayout>

<style>
  .notes-header {
    margin-bottom: 32px;
  }

  .page-label {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: 28px;
    color: var(--accent);
    margin: 0 0 8px 0;
  }

  .subtitle {
    font-style: italic;
    color: var(--text-muted);
    font-size: 15px;
    margin: 0;
  }

  .empty {
    font-style: italic;
    color: var(--text-muted);
  }

  .note-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .note-row {
    border-bottom: 1px solid var(--border-subtle);
  }

  .note-row:last-child {
    border-bottom: none;
  }

  .note-link {
    display: grid;
    grid-template-columns: 96px 1fr;
    align-items: baseline;
    gap: 20px;
    padding: 14px 0;
    color: var(--text-body);
  }

  .note-date {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  /* The underline is scoped to .note-title (a span with .link-underline) so it
     ends where the title text ends, not where the row ends. We mirror :hover
     state from the outer anchor onto the inner span so hovering anywhere on
     the row still triggers the underline. */
  .note-title {
    font-size: 18px;
    display: inline-block;
  }

  .note-link:hover .link-underline,
  .note-link:focus-visible .link-underline {
    color: var(--accent);
  }

  .note-link:hover .link-underline::after,
  .note-link:focus-visible .link-underline::after {
    width: 100%;
  }

  @media (max-width: 720px) {
    .note-link {
      grid-template-columns: 84px 1fr;
      gap: 14px;
    }
  }
</style>
