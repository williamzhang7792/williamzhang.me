---
import BaseLayout from "~/layouts/BaseLayout.astro";
import BioLine from "~/components/BioLine.astro";
import Bullet from "~/components/Bullet.astro";
import BadmintonGame from "~/components/BadmintonGame.astro";
import { about } from "~/data/about";

const title = `${about.name}`;
---

<BaseLayout title={title} description={about.positioning} bodyClass="about-page">
  <header class="about-header">
    <h1 class="name">{about.name}</h1>
    <p class="location">{about.location}</p>
  </header>

  {about.bio.map((b) => <BioLine {...b} />)}

  <section aria-labelledby="doing-label">
    <h2 id="doing-label" class="section-label">on paper:</h2>
    <ul class="bullets">
      {about.doing.map((b) => <Bullet {...b} />)}
    </ul>
  </section>

  <section aria-labelledby="thinking-label">
    <h2 id="thinking-label" class="section-label">in my head:</h2>
    <ul class="bullets">
      {about.thinking.map((b) => <Bullet {...b} />)}
    </ul>
  </section>

  <BadmintonGame />
</BaseLayout>

<style>
  .about-header {
    margin-bottom: 12px;
  }

  .name {
    font-family: var(--font-display);
    /* Pin the wordmark to Newsreader's display cut — auto opsz at 28px
       lands on the sturdier text cut, losing the Signifier-like contrast. */
    font-variation-settings: "opsz" 72;
    font-weight: 700;
    font-size: 28px;
    color: var(--accent);
    margin: 0 0 2px 0;
    letter-spacing: -0.005em;
    line-height: 1.15;
  }

  .location {
    font-style: italic;
    color: var(--text-muted);
    margin: 0;
    font-size: 14px;
  }

  .bullets {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
