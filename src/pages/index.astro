---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Bullet from "~/components/Bullet.astro";
import BadmintonGame from "~/components/BadmintonGame.astro";
import { about } from "~/data/about";

const title = `${about.name}`;
---

<BaseLayout title={title} description={about.positioning}>
  <header class="about-header">
    <h1 class="name">{about.name}</h1>
    <p class="location">{about.location}</p>
    <p class="lately">
      <span class="lately-label">lately:</span> {about.lately}
    </p>
  </header>

  <p class="positioning">{about.positioning}</p>

  <section aria-labelledby="doing-label">
    <h2 id="doing-label" class="section-label">i've been doing:</h2>
    <ul class="bullets">
      {about.doing.map((b) => <Bullet {...b} />)}
    </ul>
  </section>

  <section aria-labelledby="thinking-label">
    <h2 id="thinking-label" class="section-label">i've been thinking about:</h2>
    <ul class="bullets">
      {about.thinking.map((b) => <Bullet {...b} />)}
    </ul>
  </section>

  <BadmintonGame />
</BaseLayout>

<style>
  .about-header {
    margin-bottom: 28px;
  }

  .name {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 36px;
    color: var(--accent);
    margin: 0 0 4px 0;
    letter-spacing: -0.005em;
  }

  .location {
    font-style: italic;
    color: var(--text-muted);
    margin: 0 0 6px 0;
    font-size: 16px;
  }

  .lately {
    font-style: italic;
    color: var(--text-muted);
    font-size: 15px;
    margin: 0;
    line-height: 1.5;
  }

  .lately-label {
    color: var(--accent);
    font-weight: 500;
  }

  .positioning {
    margin: 24px 0 0 0;
    font-size: 18px;
    line-height: 1.7;
  }

  .bullets {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
