---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Bullet from "~/components/Bullet.astro";
import BadmintonGame from "~/components/BadmintonGame.astro";
import { about } from "~/data/about";

const title = `${about.name}`;
---

<BaseLayout title={title} description={about.positioning}>
  <header class="about-header">
    <h1 class="name">{about.name}</h1>
    <p class="location">{about.location}</p>
  </header>

  <p class="bio-line">
    Computing &amp; Statistics <span class="bio-at" aria-hidden="true">@</span> <a
      href="https://uwaterloo.ca/"
      class="link-strong"
      rel="noopener noreferrer"
      target="_blank"
    >UWaterloo</a>
  </p>

  <section aria-labelledby="doing-label">
    <h2 id="doing-label" class="section-label">i've been doing:</h2>
    <ul class="bullets">
      {about.doing.map((b) => <Bullet {...b} />)}
    </ul>
  </section>

  <section aria-labelledby="thinking-label">
    <h2 id="thinking-label" class="section-label">i've been thinking about:</h2>
    <ul class="bullets">
      {about.thinking.map((b) => <Bullet {...b} />)}
    </ul>
  </section>

  <BadmintonGame />
</BaseLayout>

<style>
  .about-header {
    margin-bottom: 12px;
  }

  .name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 28px;
    color: var(--accent);
    margin: 0 0 2px 0;
    letter-spacing: -0.005em;
    line-height: 1.15;
  }

  .location {
    font-style: italic;
    color: var(--text-muted);
    margin: 0;
    font-size: 14px;
  }

  .bio-line {
    margin: 0 0 8px 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-body);
  }

  .bio-at {
    color: var(--text-muted);
    font-weight: 500;
    user-select: none;
  }

  .bullets {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
