---
import * as LucideIcons from "@lucide/astro";

export interface Props {
  name: string;
  size?: number;
  class?: string;
}

// Hand-drawn icons in the Lucide grammar (24x24, stroke 1.5, round caps).
// Everything else resolves to a Lucide icon by PascalCase name.
const CUSTOM_ICONS = ["shuttlecock", "corgi", "uwaterloo"];

const { name, size = 16, class: className, ...rest } = Astro.props;

const isCustomIcon = CUSTOM_ICONS.includes(name);
const LucideIcon = isCustomIcon
  ? null
  : ((LucideIcons as unknown as Record<string, any>)[name] ?? null);

if (!isCustomIcon && !LucideIcon && import.meta.env.DEV) {
  console.warn(`[Icon] Unknown Lucide icon "${name}". Falling back to no icon.`);
}
---

{isCustomIcon ? (
  <svg
    class={className}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    width={size}
    height={size}
    {...rest}
  >
    {name === "shuttlecock" && (
      <Fragment>
        <ellipse cx="12" cy="18.5" rx="2.4" ry="1.6" />
        <line x1="9.6" y1="18.5" x2="14.4" y2="18.5" />
        <line x1="10" y1="17.6" x2="6.5" y2="4" />
        <line x1="11" y1="17.4" x2="9.75" y2="3.25" />
        <line x1="13" y1="17.4" x2="14.25" y2="3.25" />
        <line x1="14" y1="17.6" x2="17.5" y2="4" />
        <line x1="12" y1="17.3" x2="12" y2="3" />
        <path d="M6.5 4 Q 12 2.4 17.5 4" />
      </Fragment>
    )}
    {name === "corgi" && (
      <Fragment>
        <path d="M3.6 8.2 L4.6 2.8 L8 6.2" />
        <path d="M9.6 6.2 L11.6 2.6 L14 6.6" />
        <path d="M3.6 8.2 C2.9 9 2.5 9.9 2.5 10.8 L4.6 12.5 C5.4 13 6.5 13.3 7.7 13.4" />
        <path d="M5.4 9.4 L5.45 9.4" />
        <path d="M14 6.6 C16.9 7.3 19.2 8.7 20.6 11 C21.8 13.2 21.6 15.4 20.4 16.9" />
        <path d="M20.3 16.8 L20.3 20.2" />
        <path d="M15.3 17.2 L15.3 20.2" />
        <path d="M8.6 20.2 L8.6 14.1 C8.6 13.8 8.3 13.6 7.7 13.4" />
        <path d="M9.7 16.9 C11.5 17.3 13.4 17.4 15.3 17.2" />
      </Fragment>
    )}
    {name === "uwaterloo" && (
      <Fragment>
        <path d="M5 4 H19 V11.5 C19 16.1 16.4 18.9 12 21 C7.6 18.9 5 16.1 5 11.5 Z" />
        <path d="M7.6 10.6 L12 7.4 L16.4 10.6" />
        <path d="M7.4 15.4 L12 12.2 L16.6 15.4" />
      </Fragment>
    )}
  </svg>
) : LucideIcon ? (
  <LucideIcon size={size} class={className} aria-hidden="true" {...rest} />
) : (
  <span class={className} aria-hidden="true" {...rest}></span>
)}
