---
import type { Bullet as BulletType, TextPart } from "~/data/about";
import Icon from "~/components/Icon.astro";

export interface Props extends BulletType {}

const { icon, parts } = Astro.props;

const isLinkPart = (p: TextPart): p is { label: string; href: string } =>
  typeof p === "object" && p !== null && "href" in p;
---

<p class="bio-line">
  <Icon name={icon} class={`bio-icon bio-icon--${icon}`} />

  <span class="bio-text">
    {parts.map((part) =>
      isLinkPart(part) ? (
        <a
          href={part.href}
          class="link-strong"
          rel={part.href.startsWith("http") ? "noopener noreferrer" : undefined}
          target={part.href.startsWith("http") ? "_blank" : undefined}
        >{part.label}</a>
      ) : (
        <span class="bio-plain">{part}</span>
      ),
    )}
  </span>
</p>

<style>
  /* Same geometry as .bullet (minus the arrow) so the bio icons sit in the
     same visual system as the list icons below. */
  .bio-line {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0 0 8px 0;
    font-size: 16px;
    line-height: 1.55;
  }

  .bio-icon {
    color: var(--text-muted);
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    transform: translateY(2px);
    align-self: center;
  }

  /* Optical nudge: the shield is a solid symmetric outline, so its bbox
     center IS its visual center — it reads lower than the corgi, whose
     thin legs make its mass sit high. Glyph is already at the top of its
     viewBox; the rest of the correction has to live here. */
  .bio-icon--uwaterloo {
    transform: translateY(0.75px);
  }

  .bio-text {
    color: var(--text-body);
  }

  .bio-plain {
    /* explicit class so the schema reads symmetrically; no extra styles needed. */
  }
</style>
