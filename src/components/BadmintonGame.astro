---
/**
 * BadmintonGame — small canvas mini-game anchored from the badminton bullet.
 *
 * v1.1 rewrite — fixes the v1 bugs (CPU swinging at empty air, razor-thin hit
 * window) and applies the game-designer pass:
 *
 *   - Hit zone = entire player's half when shuttle is descending. No more
 *     "why didn't that work" frustration.
 *   - CPU swings only when shuttle enters its hit zone (descending and low),
 *     not when it crosses the net. This was the core "game broken" bug.
 *   - Player "w" auto-tracks the shuttle horizontally on its side (lerped),
 *     giving a visual link between input and ball.
 *   - CPU "·" tracks similarly on its side.
 *   - Hit feedback: small burgundy flash circle at impact, "w" or "·"
 *     enlarges briefly.
 *   - Net: 3 strokes in muted grey, line-width 0.8 (was 5 in burgundy).
 *   - Court line: shortened to inner 70%, line-width 0.6, muted grey.
 *   - Hit-zone hint: faint burgundy arc above the player when shuttle is
 *     descending on player's side.
 *   - Shuttle trail: 3-frame fading dot trail.
 *   - Reset fade-in: 600ms before physics resume.
 *
 * Lazy-mounted: canvas is collapsed by default.
 *
 * ROLLBACK: if it still doesn't land, delete this component, set
 * about.thinking[3] to a non-link parts entry. Bullet + shuttlecock icon stay.
 */
---

<section id="badminton" class="badminton-section" aria-label="Badminton mini-game">
  <button
    type="button"
    class="bm-trigger link-underline"
    aria-expanded="false"
    aria-controls="bm-canvas-wrap"
    id="bm-trigger"
  >
    play a quick rally
  </button>

  <p class="bm-touch-fallback" aria-hidden="true">
    badminton plays better on a desktop — open this on a real keyboard sometime
  </p>

  <div id="bm-canvas-wrap" class="bm-canvas-wrap" hidden>
    <canvas id="bm-canvas" width="400" height="300" aria-label="Badminton rally game"></canvas>
    <p class="bm-help">
      <span class="bm-help-key">space</span> or click to hit. <span class="bm-help-meta">no rules. just rally.</span>
    </p>
  </div>
</section>

<style>
  .badminton-section {
    margin: 32px 0 0 0;
  }

  .bm-trigger {
    background: none;
    border: none;
    font-family: var(--font-script);
    font-size: 22px;
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0;
    line-height: 1;
    font-style: italic;
  }

  .bm-trigger:hover,
  .bm-trigger:focus-visible {
    color: var(--accent);
    outline: none;
  }

  .bm-touch-fallback {
    display: none;
    margin: 8px 0 0 0;
    font-style: italic;
    font-size: 15px;
    color: var(--text-muted);
  }

  .bm-canvas-wrap {
    margin-top: 18px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  #bm-canvas {
    background-color: var(--bg-paper);
    border: 1px solid var(--border-subtle);
    border-radius: 2px;
    max-width: 100%;
    height: auto;
    outline: none;
    cursor: crosshair;
  }

  #bm-canvas:focus-visible {
    border-color: var(--accent);
  }

  .bm-help {
    margin: 0;
    font-family: var(--font-script);
    font-size: 17px;
    color: var(--text-muted);
    font-style: italic;
  }

  .bm-help-key {
    font-family: var(--font-mono);
    font-size: 12px;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    color: var(--accent);
    padding: 1px 6px;
    border-radius: 2px;
    font-style: normal;
  }

  .bm-help-meta {
    color: var(--text-muted);
  }

  /* Touch: hide the trigger and game, show the fallback line. */
  @media (hover: none) {
    .bm-trigger,
    .bm-canvas-wrap {
      display: none !important;
    }
    .bm-touch-fallback {
      display: block;
    }
  }

  @media (max-width: 720px) {
    #bm-canvas {
      width: 100%;
      max-width: 360px;
    }
  }
</style>

<script>
  import { safeStorage } from "~/lib/safeStorage";

  type Shuttle = {
    x: number;
    y: number;
    vx: number;
    vy: number;
    rot: number;
  };

  type FlashMsg = { text: string; x: number; y: number; rot: number; t: number };
  type HitFlash = { x: number; y: number; t: number };
  type TrailDot = { x: number; y: number; t: number };

  const trigger = document.getElementById("bm-trigger");
  const wrap = document.getElementById("bm-canvas-wrap");
  const canvas = document.getElementById("bm-canvas") as HTMLCanvasElement | null;

  if (trigger && wrap && canvas) {
    const ctx = canvas.getContext("2d")!;
    const W = canvas.width;
    const H = canvas.height;
    const NET_X = W / 2;
    const FLOOR_Y = H - 20;
    // CPU only swings once shuttle is descending and below this y.
    const CPU_HIT_ZONE_TOP = H * 0.55;

    // --- state ---
    const shuttle: Shuttle = { x: 80, y: 40, vx: 2.0, vy: 0.5, rot: 0 };
    let rally = 0;
    let bestRally = parseInt(safeStorage.get("wz-best-rally") ?? "0", 10) || 0;
    let lastHitter: "player" | "cpu" | null = null;
    let cpuReactionTimer = 0;
    let cpuReacting = false;
    let flash: FlashMsg | null = null;
    let hitFlashes: HitFlash[] = [];
    let trail: TrailDot[] = [];
    let running = false;
    let lastTime = 0;
    let resetFadeT = 0;        // 0..1, 1 = fully visible
    let frozen = false;        // shuttle frozen at floor between rallies
    let playerX = 28;          // tracked; lerps toward shuttle.x on player side
    let cpuX = W - 28;
    let playerHitPulse = 0;    // 0..1, decays after each hit, drives "w" enlarge
    let cpuHitPulse = 0;
    let hasFirstHit = false;   // hide "press space to serve" prompt after first hit

    // Caveat font may not be loaded at first paint; let it warm up.
    document.fonts?.ready?.catch(() => {});

    const winPool = [
      "ok actually",
      "the badminton hours are paying off",
      "nice",
      "you flexed",
      "ok flex",
    ];
    const losePool = [
      "ah",
      "ugh",
      "should've been studying",
      "...",
      "warmup",
      "next time",
    ];

    // --- helpers ---
    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    const pick = <T,>(arr: T[]) => arr[Math.floor(Math.random() * arr.length)];
    const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));

    function resetShuttle(servingSide: "player" | "cpu") {
      shuttle.x = servingSide === "player" ? rand(50, 130) : rand(W - 130, W - 50);
      shuttle.y = 30;
      shuttle.vx = servingSide === "player" ? rand(1.4, 2.4) : rand(-2.4, -1.4);
      shuttle.vy = 0.4;
      shuttle.rot = 0;
      // After a player miss, CPU serves toward player; mark lastHitter so the
      // server doesn't try to hit its own serve.
      lastHitter = servingSide === "player" ? "cpu" : "player";
      cpuReacting = false;
      cpuReactionTimer = 0;
      trail = [];
      hitFlashes = [];
      resetFadeT = 0; // fade in over ~600ms
      frozen = false;
    }

    function endRally(reason: "player-miss" | "cpu-miss") {
      const text = reason === "player-miss" ? pick(losePool) : pick(winPool);
      flash = {
        text,
        x: clamp(shuttle.x, 60, W - 60),
        y: clamp(shuttle.y - 8, 30, FLOOR_Y - 16),
        rot: rand(-0.07, 0.07),
        t: 1,
      };
      if (rally > bestRally) {
        bestRally = rally;
        safeStorage.set("wz-best-rally", String(bestRally));
      }
      rally = 0;
      frozen = true;
      window.setTimeout(
        () => resetShuttle(reason === "player-miss" ? "player" : "cpu"),
        1500,
      );
    }

    function playerHit() {
      // Hit zone = entire player's half when descending. No y-band check —
      // matches "if I press space and the ball is on my side, I hit it."
      if (frozen) return;
      if (shuttle.x < NET_X && shuttle.vy >= 0) {
        // Direct shuttle back, slight randomization for variety.
        const targetX = NET_X + rand(60, W - NET_X - 60);
        const dx = targetX - shuttle.x;
        const flightFrames = rand(40, 60);
        shuttle.vx = dx / flightFrames;
        // Lob arc: vy negative, magnitude proportional to flight time.
        shuttle.vy = -3.0 - rand(0, 0.8);
        rally++;
        lastHitter = "player";
        playerHitPulse = 1;
        hasFirstHit = true;
        hitFlashes.push({ x: shuttle.x, y: shuttle.y, t: 1 });
      }
    }

    function cpuHit() {
      // CPU returns the shuttle. miss probability climbs slowly with rally
      // length so very long rallies remain possible but losing eventually
      // happens organically.
      const missProb = Math.min(0.35, 0.12 + rally * 0.005);
      if (Math.random() < missProb) {
        return false; // CPU "missed" — let shuttle drop, rally ends below
      }
      const targetX = rand(60, NET_X - 60);
      const dx = targetX - shuttle.x;
      const flightFrames = rand(40, 60);
      shuttle.vx = dx / flightFrames;
      shuttle.vy = -2.8 - rand(0, 0.7);
      rally++;
      lastHitter = "cpu";
      cpuHitPulse = 1;
      hitFlashes.push({ x: shuttle.x, y: shuttle.y, t: 1 });
      return true;
    }

    function tick(dt: number) {
      // Reset fade-in: brief grace period before physics resume after a rally
      // ends, so the new shuttle doesn't feel teleported.
      if (resetFadeT < 1) {
        resetFadeT = Math.min(1, resetFadeT + dt / 36); // ~600ms at 60fps
        return;
      }

      if (frozen) return;

      // Track player horizontal position toward shuttle when shuttle is on
      // player's side; gives visual agency.
      const playerTarget = shuttle.x < NET_X ? clamp(shuttle.x, 28, NET_X - 18) : 28;
      const cpuTarget = shuttle.x >= NET_X ? clamp(shuttle.x, NET_X + 18, W - 28) : W - 28;
      playerX += (playerTarget - playerX) * 0.12 * dt;
      cpuX += (cpuTarget - cpuX) * 0.12 * dt;

      // physics
      shuttle.vy += 0.12 * dt;       // gravity (slightly stronger than v1 for snappier rallies)
      shuttle.vx *= 0.997;
      shuttle.x += shuttle.vx * dt;
      shuttle.y += shuttle.vy * dt;
      shuttle.rot = shuttle.vx * 0.045;

      // trail
      trail.unshift({ x: shuttle.x, y: shuttle.y, t: 1 });
      if (trail.length > 4) trail.length = 4;
      for (const t of trail) t.t -= 0.18 * dt;
      trail = trail.filter((t) => t.t > 0);

      // CPU AI: schedule a swing only once the shuttle is descending into
      // CPU's hit zone, not when it merely crosses the net. This was the
      // core v1 bug — fixing here.
      const onCpuSide = shuttle.x >= NET_X;
      const inCpuHitZone = onCpuSide && shuttle.vy >= 0 && shuttle.y > CPU_HIT_ZONE_TOP;
      if (inCpuHitZone && lastHitter === "player" && !cpuReacting) {
        cpuReacting = true;
        cpuReactionTimer = Math.floor(rand(8, 22)); // ~130-360ms reaction
      }

      if (cpuReacting) {
        cpuReactionTimer -= dt;
        if (cpuReactionTimer <= 0) {
          cpuReacting = false;
          // Re-verify shuttle is still in hit zone (it might have left).
          const stillInZone =
            shuttle.x >= NET_X &&
            shuttle.vy >= 0 &&
            shuttle.y > CPU_HIT_ZONE_TOP &&
            shuttle.y < FLOOR_Y;
          if (stillInZone) {
            cpuHit();
          }
        }
      }

      // Floor — end rally
      if (shuttle.y >= FLOOR_Y) {
        if (shuttle.x < NET_X) endRally("player-miss");
        else endRally("cpu-miss");
        shuttle.y = FLOOR_Y;
        shuttle.vx = 0;
        shuttle.vy = 0;
      }

      // Walls (mostly cosmetic — physics keep shuttle in canvas).
      if (shuttle.x < 6) { shuttle.x = 6; shuttle.vx = Math.abs(shuttle.vx) * 0.5; }
      if (shuttle.x > W - 6) { shuttle.x = W - 6; shuttle.vx = -Math.abs(shuttle.vx) * 0.5; }
      if (shuttle.y < 6) { shuttle.y = 6; shuttle.vy = Math.abs(shuttle.vy) * 0.5; }

      // Decay pulses + flashes
      playerHitPulse = Math.max(0, playerHitPulse - 0.06 * dt);
      cpuHitPulse = Math.max(0, cpuHitPulse - 0.06 * dt);
      for (const f of hitFlashes) f.t -= 0.06 * dt;
      hitFlashes = hitFlashes.filter((f) => f.t > 0);

      if (flash) {
        flash.t -= 0.013 * dt;
        if (flash.t <= 0) flash = null;
      }
    }

    // --- drawing ---
    function drawWashi() {
      // Cheap noise overlay inside canvas — match outer paper feel. Sparse
      // to avoid GC churn on every frame.
      ctx.save();
      ctx.globalAlpha = 0.025;
      ctx.fillStyle = "#000";
      for (let i = 0; i < 60; i++) {
        ctx.fillRect(Math.random() * W, Math.random() * H, 1, 1);
      }
      ctx.restore();
    }

    function drawCourtLine() {
      // Shortened, lighter, muted-grey: reads as boundary not wall.
      ctx.save();
      ctx.strokeStyle = "#9A9A98";
      ctx.lineWidth = 0.6;
      const xStart = W * 0.15;
      const xEnd = W * 0.85;
      const y = FLOOR_Y;
      ctx.beginPath();
      ctx.moveTo(xStart, y + (Math.random() - 0.5) * 0.4);
      for (let x = xStart + 8; x <= xEnd; x += 8) {
        ctx.lineTo(x, y + (Math.random() - 0.5) * 0.6);
      }
      ctx.stroke();
      ctx.restore();
    }

    function drawNet() {
      // 3 short pen-strokes, muted grey at low weight. Drops the visual
      // dominance the v1 burgundy net had.
      ctx.save();
      ctx.strokeStyle = "#9A9A98";
      ctx.lineWidth = 0.8;
      const top = FLOOR_Y - 64;
      const bot = FLOOR_Y - 4;
      for (let i = 0; i < 3; i++) {
        const nx = NET_X + (i - 1) * 1.4 + (Math.random() - 0.5) * 0.6;
        ctx.beginPath();
        ctx.moveTo(nx, top + i * 0.8);
        ctx.lineTo(nx + (Math.random() - 0.5) * 1.0, bot - i * 0.6);
        ctx.stroke();
      }
      ctx.restore();
    }

    function drawHitZoneHint() {
      // Faint burgundy arc above the player when shuttle is descending on
      // player's side — communicates "you can hit now."
      if (frozen || resetFadeT < 1) return;
      if (shuttle.x >= NET_X || shuttle.vy < 0) return;
      ctx.save();
      ctx.globalAlpha = 0.1;
      ctx.strokeStyle = "#7A0E20";
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(playerX, FLOOR_Y - 20, 22, Math.PI * 1.05, Math.PI * 1.95);
      ctx.stroke();
      ctx.restore();
    }

    function drawPlayerAndCPU() {
      ctx.save();
      // Player as a substantial lowercase "w" in Caveat — much more visible
      // than v1's 22px static glyph. Briefly enlarges on hit via pulse.
      const pSize = 24 + playerHitPulse * 6;
      ctx.fillStyle = "#7A0E20";
      ctx.font = `600 italic ${pSize}px Caveat, cursive`;
      ctx.textBaseline = "middle";
      ctx.textAlign = "center";
      ctx.fillText("w", playerX, FLOOR_Y - 14);

      // CPU as a stylized "·" mark — same visual language, less prominent.
      const cSize = 22 + cpuHitPulse * 6;
      ctx.font = `600 italic ${cSize}px Caveat, cursive`;
      ctx.fillText("·", cpuX, FLOOR_Y - 16);
      ctx.restore();
    }

    function drawShuttle() {
      // Trail (drawn first so shuttle paints over it).
      ctx.save();
      const trailColor = "#7A0E20";
      for (const t of trail) {
        ctx.globalAlpha = 0.18 * t.t;
        ctx.fillStyle = trailColor;
        ctx.beginPath();
        ctx.arc(t.x, t.y + 4, 2.2, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();

      // Reset fade-in: shuttle fades up after rally end.
      ctx.save();
      ctx.globalAlpha = resetFadeT;
      ctx.translate(shuttle.x, shuttle.y);
      ctx.rotate(shuttle.rot);
      ctx.strokeStyle = "#1c1c1c";
      ctx.lineWidth = 1.2;
      ctx.lineCap = "round";
      ctx.lineJoin = "round";
      ctx.beginPath();
      // feathers fanning up from cork at +y
      for (let i = -2; i <= 2; i++) {
        ctx.moveTo(0, 4);
        ctx.lineTo(i * 2.4, -7);
      }
      ctx.stroke();
      // cork (filled tiny ellipse)
      ctx.fillStyle = "#7A0E20";
      ctx.beginPath();
      ctx.ellipse(0, 5, 2.6, 1.6, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    function drawHitFlashes() {
      ctx.save();
      ctx.fillStyle = "#7A0E20";
      for (const f of hitFlashes) {
        ctx.globalAlpha = 0.4 * f.t;
        ctx.beginPath();
        ctx.arc(f.x, f.y, 4 + (1 - f.t) * 8, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();
    }

    function drawCounters() {
      ctx.save();
      ctx.fillStyle = "#7A0E20";
      ctx.font = "500 italic 19px Caveat, cursive";
      ctx.textBaseline = "top";
      ctx.textAlign = "left";
      ctx.fillText(`rally: ${rally}`, 14, 12);

      ctx.fillStyle = "#9A9A98";
      ctx.font = "500 italic 14px Caveat, cursive";
      ctx.textAlign = "right";
      ctx.fillText(`longest: ${bestRally}`, W - 14, 14);
      ctx.restore();
    }

    function drawIdlePrompt() {
      if (hasFirstHit || frozen) return;
      ctx.save();
      ctx.globalAlpha = 0.5 + 0.2 * Math.sin(performance.now() / 600);
      ctx.fillStyle = "#7A0E20";
      ctx.font = "italic 18px Caveat, cursive";
      ctx.textBaseline = "middle";
      ctx.textAlign = "center";
      ctx.fillText("press space to serve", W / 2, H / 2 - 24);
      ctx.restore();
    }

    function drawFlash() {
      if (!flash) return;
      ctx.save();
      ctx.globalAlpha = Math.max(0, Math.min(1, flash.t));
      ctx.translate(flash.x, flash.y - 14);
      ctx.rotate(flash.rot);
      ctx.fillStyle = "#7A0E20";
      ctx.font = "600 italic 24px Caveat, cursive";
      ctx.textAlign = "center";
      ctx.fillText(flash.text, 0, 0);
      ctx.restore();
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      drawWashi();
      drawCourtLine();
      drawNet();
      drawHitZoneHint();
      drawShuttle();
      drawHitFlashes();
      drawPlayerAndCPU();
      drawCounters();
      drawIdlePrompt();
      drawFlash();
    }

    function loop(t: number) {
      if (!running) return;
      const dt = lastTime ? Math.min(2, (t - lastTime) / 16.67) : 1;
      lastTime = t;
      tick(dt);
      draw();
      requestAnimationFrame(loop);
    }

    // --- input ---
    function onSpace(e: KeyboardEvent) {
      if (!running) return;
      if (e.code === "Space" || e.key === " ") {
        e.preventDefault();
        playerHit();
      }
    }
    function onClick() {
      if (!running) return;
      playerHit();
    }

    // --- toggle ---
    trigger.addEventListener("click", () => {
      const open = wrap.hasAttribute("hidden") === false;
      if (open) {
        wrap.setAttribute("hidden", "");
        trigger.setAttribute("aria-expanded", "false");
        running = false;
        window.removeEventListener("keydown", onSpace);
      } else {
        wrap.removeAttribute("hidden");
        trigger.setAttribute("aria-expanded", "true");
        // Fresh game.
        rally = 0;
        hasFirstHit = false;
        flash = null;
        hitFlashes = [];
        trail = [];
        resetShuttle("player");
        running = true;
        lastTime = 0;
        canvas.focus();
        window.addEventListener("keydown", onSpace);
        canvas.addEventListener("click", onClick);
        requestAnimationFrame(loop);
      }
    });

    canvas.tabIndex = 0;
  }
</script>
