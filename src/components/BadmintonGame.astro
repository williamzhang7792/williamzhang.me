---
/**
 * BadmintonGame — beautification pass (v1.7.5).
 *
 * Builds on v1.7.4's deterministic timing game:
 *   - Both stick figures get visible racket heads (oval + cross-string)
 *   - Body lean during peak swing (forward toward strike)
 *   - Hit-flash ring on contact (200ms expand+fade)
 *   - Bot has a hair tuft on top of head (replaces W badge)
 *   - Bot occasionally pops a Caveat-italic phrase after a return
 *   - On miss, shuttle continues past the racket and lands on the floor;
 *     rests there ~700ms before the game-over overlay fades in
 *   - "best: N" counter top-right via safeStorage persistence
 *
 * Mobile: tap-to-swing still works (touch-action: manipulation + touchstart).
 */
---

<section id="badminton" class="badminton-section" aria-label="Badminton mini-game">
  <button
    type="button"
    class="bm-trigger link-underline"
    aria-expanded="false"
    aria-controls="bm-canvas-wrap"
    id="bm-trigger"
  >
    play a quick rally :)
  </button>

  <div id="bm-canvas-wrap" class="bm-canvas-wrap" hidden>
    <canvas id="bm-canvas" width="400" height="300" aria-label="Badminton rally game"></canvas>
    <p class="bm-help">
      <span class="bm-help-key">space</span> or <span class="bm-help-key">click</span> to hit.
    </p>
    <div id="bm-gameover" class="bm-gameover" hidden aria-live="polite">
      <p class="bm-gameover-rally">rally: <span id="bm-final-rally">0</span></p>
      <button type="button" id="bm-play-again" class="bm-play-again">play again</button>
    </div>
  </div>
</section>

<style>
  .badminton-section {
    margin: 20px 0 0 0;
  }

  /* Short laptop viewports: tighter top margin to help fit page above fold. */
  @media (min-width: 721px) and (max-height: 880px) {
    .badminton-section {
      margin-top: 12px;
    }
  }

  .bm-trigger {
    background: none;
    border: none;
    font-family: var(--font-script);
    font-size: 22px;
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0;
    line-height: 1;
    font-style: italic;
  }

  .bm-trigger:hover,
  .bm-trigger:focus-visible {
    color: var(--accent);
    outline: none;
  }

  .bm-canvas-wrap {
    position: relative;
    margin-top: 18px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  #bm-canvas {
    background-color: var(--bg-paper);
    border: 1px solid var(--border-subtle);
    border-radius: 2px;
    max-width: 100%;
    height: auto;
    outline: none;
    cursor: crosshair;
    touch-action: manipulation;
  }

  #bm-canvas:focus-visible {
    border-color: var(--accent);
  }

  .bm-help {
    margin: 0;
    font-family: var(--font-script);
    font-size: 17px;
    color: var(--text-muted);
    font-style: italic;
  }

  .bm-help-key {
    font-family: var(--font-mono);
    font-size: 12px;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    color: var(--accent);
    padding: 1px 6px;
    border-radius: 2px;
    font-style: normal;
  }

  .bm-gameover {
    position: absolute;
    inset: 0 0 auto 0;
    height: 300px;
    max-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    background: color-mix(in srgb, var(--bg-paper) 92%, transparent);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    border-radius: 2px;
  }

  .bm-gameover[hidden] {
    display: none;
  }

  .bm-gameover-rally {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 28px;
    font-weight: 500;
    color: var(--accent);
    margin: 0;
  }

  .bm-play-again {
    font-family: var(--font-script);
    font-size: 22px;
    font-style: italic;
    background: none;
    border: none;
    color: var(--accent);
    cursor: pointer;
    padding: 4px 0;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    line-height: 1;
  }

  .bm-play-again:hover,
  .bm-play-again:focus-visible {
    border-bottom-color: var(--accent);
    outline: none;
  }

  @media (max-width: 720px) {
    #bm-canvas {
      width: 100%;
      max-width: 360px;
    }
    .bm-gameover {
      width: 100%;
      max-width: 360px;
    }
  }
</style>

<script>
  import { safeStorage } from "~/lib/safeStorage";

  type Pt = { x: number; y: number };
  type Phase = "bot-to-user" | "user-to-bot";
  type HitFlash = { x: number; y: number; born: number };
  type Bubble = { text: string; born: number };

  const trigger     = document.getElementById("bm-trigger");
  const wrap        = document.getElementById("bm-canvas-wrap");
  const canvas      = document.getElementById("bm-canvas") as HTMLCanvasElement | null;
  const overlayEl   = document.getElementById("bm-gameover");
  const finalRallyEl = document.getElementById("bm-final-rally");
  const playAgainEl = document.getElementById("bm-play-again");

  if (trigger && wrap && canvas && overlayEl && finalRallyEl && playAgainEl) {
    const ctx = canvas.getContext("2d")!;
    const W = canvas.width;
    const H = canvas.height;

    // ---------- CONFIG ----------
    const SWING_COOLDOWN_MS    = 500;
    const HIT_WINDOW_MS        = 250;
    const BOT_TO_USER_FLIGHT_MS = 1100;
    const USER_TO_BOT_FLIGHT_MS = 1000;
    const SPEED_RAMP           = 0.97;
    const SWING_ANIM_MS        = 150;
    const PEAK_HEIGHT_PX       = 80;
    const FLOOR_REST_MS        = 700;
    const HIT_FLASH_MS         = 200;
    const BUBBLE_DURATION_MS   = 1500;
    const BUBBLE_PROBABILITY   = 0.25;

    // ---------- geometry ----------
    const NET_X = W / 2;
    const FLOOR_Y = H - 20;
    const PLAYER_X = 100;          // pushed inward from 60 to give miss-zone landing space
    const CPU_X    = W - 100;
    const SHOULDER_Y = FLOOR_Y - 18;
    const IDLE_ARM_ANGLE  = -Math.PI / 3.5;
    const SWING_ARM_ANGLE = -Math.PI / 1.9;
    // Racket head positions used as arc endpoints. The visible racket head
    // sits at (handX + dir * 12) — these endpoints are offset by 16 from
    // the shoulder (10 arm + ~6 to roughly the racket center).
    const userRacket: Pt = {
      x: PLAYER_X + Math.cos(IDLE_ARM_ANGLE) * 16,
      y: SHOULDER_Y + Math.sin(IDLE_ARM_ANGLE) * 16,
    };
    const botRacket: Pt = {
      x: CPU_X    - Math.cos(IDLE_ARM_ANGLE) * 16,
      y: SHOULDER_Y + Math.sin(IDLE_ARM_ANGLE) * 16,
    };

    // ---------- theme colors ----------
    const css = getComputedStyle(document.documentElement);
    const COLOR = {
      body:   css.getPropertyValue("--text-body").trim()     || "#1c1c1c",
      muted:  css.getPropertyValue("--text-muted").trim()    || "#9a9a98",
      accent: css.getPropertyValue("--accent").trim()        || "#7a0e20",
      paper:  css.getPropertyValue("--bg-paper").trim()      || "#f5eddd",
    } as const;

    // ---------- state ----------
    let phase: Phase = "bot-to-user";
    let phaseStartTime = 0;
    let phaseDuration  = BOT_TO_USER_FLIGHT_MS;
    let rally = 0;
    let bestRally = parseInt(safeStorage.get("wz-best-rally") ?? "0", 10) || 0;
    let lastSwingTime  = -Infinity;
    let userSwingStart = -Infinity;
    let botSwingStart  = -Infinity;
    let gameOver = false;
    let running  = false;
    let hiddenStart = 0;

    // Miss / landing state
    let landingPhase = false;     // user has missed; shuttle continues to floor
    let landedAt = 0;             // performance.now() when shuttle.y first hit floor
    let landedX = 0;              // x where the shuttle landed (frozen for floor rest)

    // Effects
    let hitFlashes: HitFlash[] = [];
    let bubble: Bubble | null = null;

    const bubblePool = [
      "keep it up", "nice", "huh", "real?", "ok ok",
      "warmup", "hmm", "oof", "uh oh", "you're cooking",
      "ok flex", "...",
    ];

    document.fonts?.ready?.catch(() => {});

    // ---------- helpers ----------

    function arcPos(start: Pt, endPt: Pt, t: number): Pt {
      const x = start.x + (endPt.x - start.x) * t;
      const yLinear = start.y + (endPt.y - start.y) * t;
      const yArc = -PEAK_HEIGHT_PX * 4 * t * (1 - t);
      return { x, y: yLinear + yArc };
    }

    function swingFor(start: number, now: number): number {
      const elapsed = now - start;
      if (elapsed < 0 || elapsed > SWING_ANIM_MS) return 0;
      const t = elapsed / SWING_ANIM_MS;
      return 4 * t * (1 - t);
    }

    function currentArc(): { start: Pt; endPt: Pt } {
      return phase === "bot-to-user"
        ? { start: botRacket,  endPt: userRacket }
        : { start: userRacket, endPt: botRacket  };
    }

    function shuttleRot(start: Pt, endPt: Pt, t: number): number {
      const dx = endPt.x - start.x;
      const dy = (endPt.y - start.y) - PEAK_HEIGHT_PX * 4 * (1 - 2 * t);
      return Math.atan2(-dx, dy);
    }

    function spawnHitFlash(x: number, y: number) {
      hitFlashes.push({ x, y, born: performance.now() });
    }

    function maybeShowBubble() {
      if (Math.random() > BUBBLE_PROBABILITY) return;
      bubble = {
        text: bubblePool[Math.floor(Math.random() * bubblePool.length)],
        born: performance.now(),
      };
    }

    // ---------- game flow ----------

    function startPhase(p: Phase) {
      phase = p;
      phaseStartTime = performance.now();
      phaseDuration = (p === "bot-to-user" ? BOT_TO_USER_FLIGHT_MS : USER_TO_BOT_FLIGHT_MS)
                    * Math.pow(SPEED_RAMP, rally);
    }

    function startGame() {
      rally = 0;
      gameOver = false;
      overlayEl!.setAttribute("hidden", "");
      finalRallyEl!.textContent = "0";
      lastSwingTime  = -Infinity;
      userSwingStart = -Infinity;
      hitFlashes = [];
      bubble = null;
      landingPhase = false;
      landedAt = 0;
      landedX = 0;
      startPhase("bot-to-user");
      // First-serve bot swing: peak at phase start.
      botSwingStart = phaseStartTime - SWING_ANIM_MS / 2;
      canvas!.focus();
    }

    function endRally() {
      if (rally > bestRally) {
        bestRally = rally;
        safeStorage.set("wz-best-rally", String(bestRally));
      }
      gameOver = true;
      finalRallyEl!.textContent = String(rally);
      overlayEl!.removeAttribute("hidden");
      playAgainEl!.focus();
    }

    function attemptSwing() {
      if (!running || gameOver) return;
      const now = performance.now();
      if (now - lastSwingTime < SWING_COOLDOWN_MS) return;
      lastSwingTime = now;
      userSwingStart = now - SWING_ANIM_MS / 2;

      if (phase !== "bot-to-user" || landingPhase) return;
      const elapsed = now - phaseStartTime;
      const inWindow = Math.abs(elapsed - phaseDuration) <= HIT_WINDOW_MS / 2;
      if (!inWindow) return;

      spawnHitFlash(userRacket.x, userRacket.y);
      rally++;
      startPhase("user-to-bot");
    }

    // ---------- tick ----------

    function tick(now: number) {
      if (gameOver) return;
      const elapsed = now - phaseStartTime;
      const t = elapsed / phaseDuration;

      if (phase === "user-to-bot") {
        // Pre-schedule bot's return swing so the bell peak lines up with contact.
        if (botSwingStart < phaseStartTime
            && elapsed > phaseDuration - SWING_ANIM_MS / 2) {
          botSwingStart = now;
        }
        if (t >= 1) {
          spawnHitFlash(botRacket.x, botRacket.y);
          if (rally > 0) maybeShowBubble();           // not on the very first serve
          startPhase("bot-to-user");
          return;
        }
      } else {
        // bot-to-user: detect miss + shuttle landing on floor
        if (!landingPhase && elapsed > phaseDuration + HIT_WINDOW_MS / 2) {
          landingPhase = true;
        }
        if (landingPhase && landedAt === 0) {
          const { start, endPt } = currentArc();
          const pos = arcPos(start, endPt, t);
          if (pos.y >= FLOOR_Y) {
            landedAt = now;
            landedX = pos.x;
          }
        }
        if (landedAt > 0 && now - landedAt > FLOOR_REST_MS) {
          endRally();
        }
      }
    }

    // ---------- drawing ----------

    function drawCourtLine() {
      ctx.save();
      ctx.strokeStyle = COLOR.muted;
      ctx.lineWidth = 0.6;
      const xStart = W * 0.08;
      const xEnd = W * 0.92;
      const y = FLOOR_Y;
      ctx.beginPath();
      ctx.moveTo(xStart, y + (Math.random() - 0.5) * 0.4);
      for (let x = xStart + 8; x <= xEnd; x += 8) {
        ctx.lineTo(x, y + (Math.random() - 0.5) * 0.6);
      }
      ctx.stroke();
      ctx.restore();
    }

    function drawNet() {
      ctx.save();
      ctx.strokeStyle = COLOR.muted;
      ctx.lineWidth = 0.8;
      const top = FLOOR_Y - 64;
      const bot = FLOOR_Y - 4;
      for (let i = 0; i < 3; i++) {
        const nx = NET_X + (i - 1) * 1.4 + (Math.random() - 0.5) * 0.6;
        ctx.beginPath();
        ctx.moveTo(nx, top + i * 0.8);
        ctx.lineTo(nx + (Math.random() - 0.5) * 1.0, bot - i * 0.6);
        ctx.stroke();
      }
      ctx.restore();
    }

    function drawRacket(handX: number, handY: number, armAngle: number) {
      const headLen = 12;
      const cx = handX + Math.cos(armAngle) * (headLen / 2);
      const cy = handY + Math.sin(armAngle) * (headLen / 2);
      ctx.save();
      ctx.translate(cx, cy);
      ctx.rotate(armAngle + Math.PI / 2);
      ctx.strokeStyle = COLOR.body;
      ctx.lineWidth = 1.1;
      ctx.beginPath();
      ctx.ellipse(0, 0, 3.5, 6, 0, 0, Math.PI * 2);
      ctx.stroke();
      ctx.lineWidth = 0.5;
      ctx.beginPath();
      ctx.moveTo(-3.5, 0); ctx.lineTo(3.5, 0);
      ctx.stroke();
      ctx.restore();
    }

    function drawStickFigure(x: number, isBot: boolean, swing: number) {
      const baseY = FLOOR_Y;
      const leanX = swing * 5 * (isBot ? -1 : 1);

      ctx.save();
      ctx.strokeStyle = COLOR.body;
      ctx.fillStyle = COLOR.body;
      ctx.lineWidth = 1.4;
      ctx.lineCap = "round";

      // head (leaned)
      ctx.beginPath();
      ctx.arc(x + leanX, baseY - 26, 4, 0, Math.PI * 2);
      ctx.fill();

      // hair tuft on bot — three short upward strokes
      if (isBot) {
        ctx.lineWidth = 1.1;
        ctx.beginPath();
        ctx.moveTo(x + leanX - 3, baseY - 30);
        ctx.lineTo(x + leanX - 2, baseY - 33);
        ctx.moveTo(x + leanX,     baseY - 30);
        ctx.lineTo(x + leanX,     baseY - 34);
        ctx.moveTo(x + leanX + 3, baseY - 30);
        ctx.lineTo(x + leanX + 2, baseY - 33);
        ctx.stroke();
        ctx.lineWidth = 1.4;
      }

      // body — leaned shoulder down to fixed pelvis
      ctx.beginPath();
      ctx.moveTo(x + leanX, baseY - 22);
      ctx.lineTo(x, baseY - 8);
      ctx.stroke();

      // legs (slight V stance, planted)
      ctx.beginPath();
      ctx.moveTo(x, baseY - 8);
      ctx.lineTo(x - 4, baseY);
      ctx.moveTo(x, baseY - 8);
      ctx.lineTo(x + 4, baseY);
      ctx.stroke();

      // arm — shoulder leans, hand pivots to swing angle
      const idleA  = isBot ? Math.PI - IDLE_ARM_ANGLE  : IDLE_ARM_ANGLE;
      const swingA = isBot ? Math.PI - SWING_ARM_ANGLE : SWING_ARM_ANGLE;
      const armAngle = idleA + (swingA - idleA) * swing;
      const shoulderXLean = x + leanX;
      const handX = shoulderXLean + Math.cos(armAngle) * 10;
      const handY = SHOULDER_Y + Math.sin(armAngle) * 10;
      ctx.beginPath();
      ctx.moveTo(shoulderXLean, SHOULDER_Y);
      ctx.lineTo(handX, handY);
      ctx.stroke();

      // racket head at the end of the arm
      drawRacket(handX, handY, armAngle);

      ctx.restore();
    }

    function drawShuttle(now: number) {
      const { start, endPt } = currentArc();
      const elapsed = now - phaseStartTime;
      const t = Math.max(0, elapsed / phaseDuration);
      let pos = arcPos(start, endPt, t);
      let rot = shuttleRot(start, endPt, t);

      // After landing, freeze shuttle on the floor at landed position.
      if (landedAt > 0) {
        pos = { x: landedX, y: FLOOR_Y };
        rot = Math.PI / 2; // sideways on floor (cork pointing in arc direction)
        // Actually use last computed rotation pre-landing — keep shuttle's
        // "lying down" look. For simplicity, use sideways relative to flight.
        rot = phase === "bot-to-user" ? Math.PI / 2 : -Math.PI / 2;
      }

      ctx.save();
      ctx.translate(pos.x, pos.y);
      ctx.rotate(rot);
      ctx.strokeStyle = COLOR.body;
      ctx.lineWidth = 1.2;
      ctx.lineCap = "round";
      ctx.lineJoin = "round";
      ctx.beginPath();
      for (let i = -2; i <= 2; i++) {
        ctx.moveTo(0, 4);
        ctx.lineTo(i * 2.4, -7);
      }
      ctx.stroke();
      ctx.fillStyle = COLOR.accent;
      ctx.beginPath();
      ctx.ellipse(0, 5, 2.6, 1.6, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    function drawHitFlashes(now: number) {
      ctx.save();
      for (const f of hitFlashes) {
        const age = now - f.born;
        if (age > HIT_FLASH_MS || age < 0) continue;
        const t = age / HIT_FLASH_MS;
        ctx.globalAlpha = 1 - t;
        ctx.strokeStyle = COLOR.accent;
        ctx.lineWidth = 1.4;
        ctx.beginPath();
        ctx.arc(f.x, f.y, 2 + t * 12, 0, Math.PI * 2);
        ctx.stroke();
      }
      hitFlashes = hitFlashes.filter(f => now - f.born <= HIT_FLASH_MS);
      ctx.restore();
    }

    function drawBubble(now: number) {
      if (!bubble) return;
      const age = now - bubble.born;
      if (age > BUBBLE_DURATION_MS) {
        bubble = null;
        return;
      }
      const fadeIn = Math.min(1, age / 200);
      const fadeOut = Math.min(1, (BUBBLE_DURATION_MS - age) / 400);
      ctx.save();
      ctx.globalAlpha = Math.max(0, Math.min(fadeIn, fadeOut));
      ctx.fillStyle = COLOR.accent;
      ctx.font = "500 italic 19px Caveat, cursive";
      ctx.textAlign = "right";
      ctx.textBaseline = "alphabetic";
      ctx.fillText(bubble.text, CPU_X - 10, FLOOR_Y - 50);
      ctx.restore();
    }

    function drawCounter() {
      ctx.save();
      ctx.fillStyle = COLOR.accent;
      ctx.font = "500 italic 19px Caveat, cursive";
      ctx.textBaseline = "top";
      ctx.textAlign = "left";
      ctx.fillText(`rally: ${rally}`, 14, 12);

      ctx.fillStyle = COLOR.muted;
      ctx.font = "500 italic 14px Caveat, cursive";
      ctx.textAlign = "right";
      ctx.fillText(`best: ${bestRally}`, W - 14, 14);
      ctx.restore();
    }

    function draw(now: number) {
      ctx.clearRect(0, 0, W, H);
      drawCourtLine();
      drawNet();
      drawShuttle(now);
      drawHitFlashes(now);
      drawStickFigure(PLAYER_X, false, swingFor(userSwingStart, now));
      drawStickFigure(CPU_X,    true,  swingFor(botSwingStart,  now));
      drawBubble(now);
      drawCounter();
    }

    function loop(now: number) {
      if (!running) return;
      tick(now);
      draw(now);
      requestAnimationFrame(loop);
    }

    // ---------- input ----------

    function onSpace(e: KeyboardEvent) {
      if (!running) return;
      if (e.code !== "Space" && e.key !== " ") return;
      if (document.activeElement !== canvas) return;
      e.preventDefault();
      attemptSwing();
    }

    function onClick() {
      attemptSwing();
    }

    function onTouchStart(e: TouchEvent) {
      e.preventDefault();
      attemptSwing();
    }

    // ---------- visibility ----------

    function onVisibilityChange() {
      if (!running || gameOver) return;
      if (document.hidden) {
        hiddenStart = performance.now();
      } else {
        const offset = performance.now() - hiddenStart;
        phaseStartTime += offset;
        if (lastSwingTime  > -Infinity) lastSwingTime  += offset;
        if (userSwingStart > -Infinity) userSwingStart += offset;
        if (botSwingStart  > -Infinity) botSwingStart  += offset;
        if (landedAt > 0) landedAt += offset;
        for (const f of hitFlashes) f.born += offset;
        if (bubble) bubble.born += offset;
      }
    }

    // ---------- toggle + Play Again ----------

    playAgainEl.addEventListener("click", (e) => {
      e.stopPropagation();
      startGame();
    });

    trigger.addEventListener("click", () => {
      const isOpen = wrap.hasAttribute("hidden") === false;
      if (isOpen) {
        wrap.setAttribute("hidden", "");
        trigger.setAttribute("aria-expanded", "false");
        running = false;
        gameOver = false;
        overlayEl.setAttribute("hidden", "");
        window.removeEventListener("keydown", onSpace);
        canvas.removeEventListener("click", onClick);
        canvas.removeEventListener("touchstart", onTouchStart);
        document.removeEventListener("visibilitychange", onVisibilityChange);
      } else {
        wrap.removeAttribute("hidden");
        trigger.setAttribute("aria-expanded", "true");
        running = true;
        window.addEventListener("keydown", onSpace);
        canvas.addEventListener("click", onClick);
        canvas.addEventListener("touchstart", onTouchStart, { passive: false });
        document.addEventListener("visibilitychange", onVisibilityChange);
        startGame();
        requestAnimationFrame(loop);
      }
    });

    canvas.tabIndex = 0;
  }
</script>
