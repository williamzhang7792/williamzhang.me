---
/**
 * BadmintonGame — ambient-toy rewrite (v1.7.2).
 *
 * The smile-and-move-on version. Two stick figures, a shuttle, click or
 * space to hit. Rally goes until someone misses, brief flash, auto-serves
 * again. No states, no perfect tiers, no failure tracking. Built to be
 * easy to read so it's hard to break.
 *
 * Mechanics:
 *   - Shuttle auto-launches from the visitor's racket (underhand serve)
 *     whenever the canvas opens or after a 1.2s pause following a miss
 *   - Stick figures auto-track the shuttle horizontally on their side;
 *     return to home position during the 1.2s frozen pause
 *   - Press space/click while shuttle is on player side AND inside the
 *     hit circle = return shot. Otherwise: silent no-op (no penalty)
 *   - CPU returns automatically with a small flat miss probability
 *     that scales gently with rally length (12-27%)
 *   - Shuttle hits floor → casual flash message + auto-serve in 1.2s
 *
 * All canvas colors source from CSS tokens (--text-body, --text-muted,
 * --accent, --bg-paper, --border-subtle) at game init.
 *
 * Lazy-mounted: canvas is collapsed by default. Hidden on touch via
 * @media (hover: none); the .bm-touch-fallback line shows instead.
 */
---

<section id="badminton" class="badminton-section" aria-label="Badminton mini-game">
  <button
    type="button"
    class="bm-trigger link-underline"
    aria-expanded="false"
    aria-controls="bm-canvas-wrap"
    id="bm-trigger"
  >
    play a quick rally :)
  </button>

  <p class="bm-touch-fallback" aria-hidden="true">
    a small badminton mini-game hides on this page, but it needs a real keyboard. come back on desktop sometime :)
  </p>

  <div id="bm-canvas-wrap" class="bm-canvas-wrap" hidden>
    <canvas id="bm-canvas" width="400" height="300" aria-label="Badminton rally game"></canvas>
    <p class="bm-help">
      <span class="bm-help-key">space</span> or <span class="bm-help-key">click</span> to hit.
    </p>
  </div>
</section>

<style>
  .badminton-section {
    margin: 20px 0 0 0;
  }

  /* Short laptop viewports: tighter top margin to help fit page above fold. */
  @media (min-width: 721px) and (max-height: 880px) {
    .badminton-section {
      margin-top: 12px;
    }
  }

  .bm-trigger {
    background: none;
    border: none;
    font-family: var(--font-script);
    font-size: 22px;
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0;
    line-height: 1;
    font-style: italic;
  }

  .bm-trigger:hover,
  .bm-trigger:focus-visible {
    color: var(--accent);
    outline: none;
  }

  .bm-touch-fallback {
    display: none;
    margin: 8px 0 0 0;
    font-style: italic;
    font-size: 15px;
    color: var(--text-muted);
  }

  .bm-canvas-wrap {
    margin-top: 18px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  #bm-canvas {
    background-color: var(--bg-paper);
    border: 1px solid var(--border-subtle);
    border-radius: 2px;
    max-width: 100%;
    height: auto;
    outline: none;
    cursor: crosshair;
  }

  #bm-canvas:focus-visible {
    border-color: var(--accent);
  }

  .bm-help {
    margin: 0;
    font-family: var(--font-script);
    font-size: 17px;
    color: var(--text-muted);
    font-style: italic;
  }

  .bm-help-key {
    font-family: var(--font-mono);
    font-size: 12px;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    color: var(--accent);
    padding: 1px 6px;
    border-radius: 2px;
    font-style: normal;
  }

  /* Touch: hide the trigger and game, show the fallback line. */
  @media (hover: none) {
    .bm-trigger,
    .bm-canvas-wrap {
      display: none !important;
    }
    .bm-touch-fallback {
      display: block;
    }
  }

  @media (max-width: 720px) {
    #bm-canvas {
      width: 100%;
      max-width: 360px;
    }
  }
</style>

<script>
  import { safeStorage } from "~/lib/safeStorage";

  type Shuttle = { x: number; y: number; vx: number; vy: number; rot: number };
  type FlashMsg = { text: string; x: number; y: number; rot: number; t: number };
  type TrailDot = { x: number; y: number; t: number };

  const trigger = document.getElementById("bm-trigger");
  const wrap = document.getElementById("bm-canvas-wrap");
  const canvas = document.getElementById("bm-canvas") as HTMLCanvasElement | null;

  if (trigger && wrap && canvas) {
    const ctx = canvas.getContext("2d")!;
    const W = canvas.width;
    const H = canvas.height;
    const NET_X = W / 2;
    const FLOOR_Y = H - 20;

    const HIT_CIRCLE_RADIUS = 30;
    const HIT_CENTER_OFFSET_Y = 24;
    // CPU only swings once shuttle is descending and below this y.
    const CPU_HIT_ZONE_TOP = H * 0.55;

    // Theme colors sourced from CSS custom properties.
    const css = getComputedStyle(document.documentElement);
    const COLOR = {
      body:   css.getPropertyValue("--text-body").trim()     || "#1c1c1c",
      muted:  css.getPropertyValue("--text-muted").trim()    || "#9a9a98",
      accent: css.getPropertyValue("--accent").trim()        || "#7a0e20",
      paper:  css.getPropertyValue("--bg-paper").trim()      || "#f5eddd",
      border: css.getPropertyValue("--border-subtle").trim() || "#d5d5d3",
    } as const;

    // --- state ---
    const shuttle: Shuttle = { x: 40, y: FLOOR_Y - 24, vx: 0, vy: 0, rot: 0 };
    let rally = 0;
    let bestRally = parseInt(safeStorage.get("wz-best-rally") ?? "0", 10) || 0;
    let lastHitter: "player" | "cpu" = "cpu";
    let cpuReacting = false;
    let cpuReactionTimer = 0;
    let flash: FlashMsg | null = null;
    let trail: TrailDot[] = [];
    let playerX = 40;
    let cpuX = W - 40;
    let playerSwinging = 0;
    let cpuSwinging = 0;
    let playerHasHit = false;
    let frozen = false;                              // shuttle parked at floor between rallies
    let prevOnPlayerSide = true;                     // bug 5 fix: detect side cross-back
    let pendingServeTimer: number | null = null;     // bug 1 fix: track + clear
    let running = false;
    let lastTime = 0;

    // Caveat font may not be loaded at first paint; let it warm up.
    document.fonts?.ready?.catch(() => {});

    const winPool = [
      "ok actually",
      "the badminton hours are paying off",
      "nice",
      "you flexed",
      "ok flex",
    ];
    const losePool = [
      "ah",
      "ugh",
      "should've been studying",
      "...",
      "warmup",
      "next time",
    ];

    // --- helpers ---
    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    const pick = <T,>(arr: T[]) => arr[Math.floor(Math.random() * arr.length)];
    const clamp = (v: number, lo: number, hi: number) =>
      Math.max(lo, Math.min(hi, v));

    function shuttleOnPlayerSide(): boolean {
      return shuttle.x < NET_X;
    }

    function clearPendingServeTimer() {
      if (pendingServeTimer !== null) {
        clearTimeout(pendingServeTimer);
        pendingServeTimer = null;
      }
    }

    // --- game actions ---

    function autoServe() {
      // Shuttle starts at the visitor's racket-hand position (matches
      // drawStickFigure's idle arm angle). Underhand serve forward over net.
      const shoulderY = FLOOR_Y - 18;
      const idleArmAngle = -Math.PI / 3.5;
      shuttle.x = playerX + Math.cos(idleArmAngle) * 10;
      shuttle.y = shoulderY + Math.sin(idleArmAngle) * 10;
      shuttle.vx = rand(1.6, 2.0);
      shuttle.vy = rand(-3.8, -3.2);
      shuttle.rot = 0;
      rally = 0;
      playerHasHit = false;
      trail = [];
      cpuReacting = false;
      cpuReactionTimer = 0;
      lastHitter = "player";
      playerSwinging = 1;
      frozen = false;
      prevOnPlayerSide = true;
    }

    function attemptHit() {
      if (frozen) return;
      if (!shuttleOnPlayerSide()) return;
      if (playerHasHit) return;

      const cy = FLOOR_Y - HIT_CENTER_OFFSET_Y;
      const dx = shuttle.x - playerX;
      const dy = shuttle.y - cy;
      const dist = Math.sqrt(dx * dx + dy * dy);
      if (dist > HIT_CIRCLE_RADIUS) return; // silent no-op outside circle

      // One return shot type with slight random variance for life.
      const targetX = NET_X + rand(60, W - NET_X - 60);
      const dxTarget = targetX - shuttle.x;
      shuttle.vx = clamp(dxTarget / 50, 1.6, 3.0);
      shuttle.vy = rand(-3.6, -2.8);
      rally++;
      lastHitter = "player";
      playerHasHit = true;
      playerSwinging = 1;
    }

    function cpuReturn() {
      // Flat miss probability with gentle rally-length scaling. Caps at 0.27
      // so very long rallies remain possible but losses happen organically.
      const missProb = 0.12 + Math.min(rally * 0.003, 0.15);
      if (Math.random() < missProb) return; // CPU misses, shuttle keeps falling
      const targetX = rand(50, NET_X - 50);
      const dxTarget = targetX - shuttle.x;
      shuttle.vx = clamp(dxTarget / 50, -3.0, -1.6);
      shuttle.vy = rand(-3.6, -2.8);
      rally++;
      lastHitter = "cpu";
      cpuSwinging = 1;
      // Note: playerHasHit reset is handled by the side-transition check
      // in tick() (bug 5 fix), not here. Keeps reset logic in one place.
    }

    function endRally(reason: "player-miss" | "cpu-miss") {
      const text = pick(reason === "player-miss" ? losePool : winPool);
      flash = {
        text,
        x: clamp(shuttle.x, 60, W - 60),
        y: clamp(shuttle.y - 8, 30, FLOOR_Y - 16),
        rot: rand(-0.07, 0.07),
        t: 1,
      };
      if (rally > bestRally) {
        bestRally = rally;
        safeStorage.set("wz-best-rally", String(bestRally));
      }
      frozen = true;
      shuttle.vx = 0;
      shuttle.vy = 0;

      // Bug 1 fix: track the pending timer so close + reopen can cancel it.
      pendingServeTimer = window.setTimeout(() => {
        pendingServeTimer = null;
        autoServe();
      }, 1200);
    }

    // --- physics + AI ---

    function tick(dt: number) {
      // Animation decays — always run regardless of frozen state.
      playerSwinging = Math.max(0, playerSwinging - 0.06 * dt);
      cpuSwinging = Math.max(0, cpuSwinging - 0.06 * dt);
      if (flash) {
        flash.t -= 0.013 * dt;
        if (flash.t <= 0) flash = null;
      }

      // Bug 3 fix: stick figures lerp to home positions when frozen,
      // shuttle-tracking positions otherwise. Prevents the player from
      // walking toward the dead shuttle during the 1.2s pause.
      const playerTarget = frozen
        ? 40
        : shuttleOnPlayerSide()
          ? clamp(shuttle.x, 28, NET_X - 18)
          : 40;
      const cpuTarget = frozen
        ? W - 40
        : shuttleOnPlayerSide()
          ? W - 40
          : clamp(shuttle.x, NET_X + 18, W - 28);
      playerX += (playerTarget - playerX) * 0.12 * dt;
      cpuX += (cpuTarget - cpuX) * 0.12 * dt;

      if (frozen) return; // skip physics + AI while parked

      // physics
      shuttle.vy += 0.10 * dt; // gravity (slightly slower than v1.7's 0.12)
      shuttle.vx *= 0.997;
      shuttle.x += shuttle.vx * dt;
      shuttle.y += shuttle.vy * dt;
      shuttle.rot = shuttle.vx * 0.045;

      // Bug 5 fix: detect shuttle returning to player side from CPU side.
      // Reset playerHasHit so wall-bounces / CPU misses don't trap the player
      // in an unhittable state.
      const onPlayerSide = shuttleOnPlayerSide();
      if (!prevOnPlayerSide && onPlayerSide) {
        playerHasHit = false;
      }
      prevOnPlayerSide = onPlayerSide;

      // trail
      trail.unshift({ x: shuttle.x, y: shuttle.y, t: 1 });
      if (trail.length > 4) trail.length = 4;
      for (const t of trail) t.t -= 0.18 * dt;
      trail = trail.filter((t) => t.t > 0);

      // CPU AI: schedule a swing once the shuttle enters CPU's hit zone.
      const onCpuSide = shuttle.x >= NET_X;
      const inCpuHitZone =
        onCpuSide && shuttle.vy >= 0 && shuttle.y > CPU_HIT_ZONE_TOP;
      if (inCpuHitZone && lastHitter === "player" && !cpuReacting) {
        cpuReacting = true;
        cpuReactionTimer = Math.floor(rand(8, 22));
      }

      if (cpuReacting) {
        cpuReactionTimer -= dt;
        if (cpuReactionTimer <= 0) {
          cpuReacting = false;
          const stillInZone =
            shuttle.x >= NET_X &&
            shuttle.vy >= 0 &&
            shuttle.y > CPU_HIT_ZONE_TOP &&
            shuttle.y < FLOOR_Y;
          if (stillInZone) cpuReturn();
          // else: shuttle left the hit zone before CPU swung; let it fall.
        }
      }

      // Floor — end rally
      if (shuttle.y >= FLOOR_Y) {
        if (shuttle.x < NET_X) endRally("player-miss");
        else endRally("cpu-miss");
        shuttle.y = FLOOR_Y;
        shuttle.vx = 0;
        shuttle.vy = 0;
        return;
      }

      // Walls (mostly cosmetic — physics keep shuttle in canvas).
      if (shuttle.x < 6) {
        shuttle.x = 6;
        shuttle.vx = Math.abs(shuttle.vx) * 0.5;
      }
      if (shuttle.x > W - 6) {
        shuttle.x = W - 6;
        shuttle.vx = -Math.abs(shuttle.vx) * 0.5;
      }
      if (shuttle.y < 6) {
        shuttle.y = 6;
        shuttle.vy = Math.abs(shuttle.vy) * 0.5;
      }
    }

    // --- drawing ---

    function drawWashi() {
      // Cheap noise overlay to match outer paper feel.
      ctx.save();
      ctx.globalAlpha = 0.025;
      ctx.fillStyle = COLOR.body;
      for (let i = 0; i < 60; i++) {
        ctx.fillRect(Math.random() * W, Math.random() * H, 1, 1);
      }
      ctx.restore();
    }

    function drawCourtLine() {
      ctx.save();
      ctx.strokeStyle = COLOR.muted;
      ctx.lineWidth = 0.6;
      const xStart = W * 0.15;
      const xEnd = W * 0.85;
      const y = FLOOR_Y;
      ctx.beginPath();
      ctx.moveTo(xStart, y + (Math.random() - 0.5) * 0.4);
      for (let x = xStart + 8; x <= xEnd; x += 8) {
        ctx.lineTo(x, y + (Math.random() - 0.5) * 0.6);
      }
      ctx.stroke();
      ctx.restore();
    }

    function drawNet() {
      ctx.save();
      ctx.strokeStyle = COLOR.muted;
      ctx.lineWidth = 0.8;
      const top = FLOOR_Y - 64;
      const bot = FLOOR_Y - 4;
      for (let i = 0; i < 3; i++) {
        const nx = NET_X + (i - 1) * 1.4 + (Math.random() - 0.5) * 0.6;
        ctx.beginPath();
        ctx.moveTo(nx, top + i * 0.8);
        ctx.lineTo(nx + (Math.random() - 0.5) * 1.0, bot - i * 0.6);
        ctx.stroke();
      }
      ctx.restore();
    }

    function drawHitCircle() {
      // Single ring around the visitor. Brightens when shuttle is inside.
      const cx = playerX;
      const cy = FLOOR_Y - HIT_CENTER_OFFSET_Y;
      const dx = shuttle.x - cx;
      const dy = shuttle.y - cy;
      const dist = Math.sqrt(dx * dx + dy * dy);
      const inside = dist <= HIT_CIRCLE_RADIUS;

      ctx.save();
      ctx.strokeStyle = COLOR.accent;
      ctx.lineWidth = inside ? 1.6 : 1;
      ctx.globalAlpha = inside ? 0.5 : 0.16;
      ctx.beginPath();
      ctx.arc(cx, cy, HIT_CIRCLE_RADIUS, 0, Math.PI * 2);
      ctx.stroke();
      ctx.restore();
    }

    /**
     * Draw a stick figure standing on FLOOR_Y. `swinging` is 0..1 where 1
     * is full swing (arm raised), 0 is idle pose. `label` (e.g. "W") is
     * rendered above the head if non-null.
     */
    function drawStickFigure(
      x: number,
      label: string | null,
      swinging: number,
    ) {
      const baseY = FLOOR_Y;
      ctx.save();
      ctx.strokeStyle = COLOR.body;
      ctx.fillStyle = COLOR.body;
      ctx.lineWidth = 1.4;
      ctx.lineCap = "round";

      // head
      ctx.beginPath();
      ctx.arc(x, baseY - 26, 4, 0, Math.PI * 2);
      ctx.fill();

      // body
      ctx.beginPath();
      ctx.moveTo(x, baseY - 22);
      ctx.lineTo(x, baseY - 8);
      ctx.stroke();

      // legs (slight V stance)
      ctx.beginPath();
      ctx.moveTo(x, baseY - 8);
      ctx.lineTo(x - 4, baseY);
      ctx.moveTo(x, baseY - 8);
      ctx.lineTo(x + 4, baseY);
      ctx.stroke();

      // racket arm — angle pivots up on swing.
      const idleAngle = -Math.PI / 3.5;
      const swingAngle = -Math.PI / 1.9;
      const armAngle = idleAngle + (swingAngle - idleAngle) * swinging;
      const shoulderY = baseY - 18;
      const handX = x + Math.cos(armAngle) * 10;
      const handY = shoulderY + Math.sin(armAngle) * 10;
      ctx.beginPath();
      ctx.moveTo(x, shoulderY);
      ctx.lineTo(handX, handY);
      // racket head — short stroke past the hand
      ctx.moveTo(handX, handY);
      ctx.lineTo(
        handX + Math.cos(armAngle) * 6,
        handY + Math.sin(armAngle) * 6,
      );
      ctx.stroke();

      // optional label (W badge for the bot).
      if (label) {
        ctx.fillStyle = COLOR.accent;
        ctx.font = "600 italic 16px Caveat, cursive";
        ctx.textAlign = "center";
        ctx.textBaseline = "alphabetic";
        ctx.fillText(label, x, baseY - 36);
      }
      ctx.restore();
    }

    function drawShuttle() {
      // Trail (drawn first so shuttle paints over it).
      ctx.save();
      for (const t of trail) {
        ctx.globalAlpha = 0.18 * t.t;
        ctx.fillStyle = COLOR.accent;
        ctx.beginPath();
        ctx.arc(t.x, t.y + 4, 2.2, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();

      // Shuttle body — alpha defaults to 1 after ctx.save().
      ctx.save();
      ctx.translate(shuttle.x, shuttle.y);
      ctx.rotate(shuttle.rot);
      ctx.strokeStyle = COLOR.body;
      ctx.lineWidth = 1.2;
      ctx.lineCap = "round";
      ctx.lineJoin = "round";
      ctx.beginPath();
      // feathers fanning up from cork at +y
      for (let i = -2; i <= 2; i++) {
        ctx.moveTo(0, 4);
        ctx.lineTo(i * 2.4, -7);
      }
      ctx.stroke();
      ctx.fillStyle = COLOR.accent;
      ctx.beginPath();
      ctx.ellipse(0, 5, 2.6, 1.6, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    function drawCounters() {
      ctx.save();
      ctx.fillStyle = COLOR.accent;
      ctx.font = "500 italic 19px Caveat, cursive";
      ctx.textBaseline = "top";
      ctx.textAlign = "left";
      ctx.fillText(`rally: ${rally}`, 14, 12);

      ctx.fillStyle = COLOR.muted;
      ctx.font = "500 italic 14px Caveat, cursive";
      ctx.textAlign = "right";
      ctx.fillText(`longest: ${bestRally}`, W - 14, 14);
      ctx.restore();
    }

    function drawFlash() {
      if (!flash) return;
      ctx.save();
      ctx.globalAlpha = clamp(flash.t, 0, 1);
      ctx.translate(flash.x, flash.y - 14);
      ctx.rotate(flash.rot);
      ctx.fillStyle = COLOR.accent;
      ctx.font = "600 italic 24px Caveat, cursive";
      ctx.textAlign = "center";
      ctx.fillText(flash.text, 0, 0);
      ctx.restore();
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      drawWashi();
      drawCourtLine();
      drawNet();
      drawHitCircle();
      drawShuttle();
      drawStickFigure(playerX, null, playerSwinging);
      drawStickFigure(cpuX, "W", cpuSwinging);
      drawCounters();
      drawFlash();
    }

    function loop(t: number) {
      if (!running) return;
      const dt = lastTime ? Math.min(2, (t - lastTime) / 16.67) : 1;
      lastTime = t;
      tick(dt);
      draw();
      requestAnimationFrame(loop);
    }

    // --- input ---

    // Bug 6 fix: only intercept space when the canvas is focused. Otherwise
    // let the browser scroll the page like normal. Canvas gets focus on open
    // via canvas.focus() in the trigger handler so playing-with-space works
    // out of the box; clicking elsewhere blurs the canvas and frees up space.
    function onSpace(e: KeyboardEvent) {
      if (!running) return;
      if (e.code !== "Space" && e.key !== " ") return;
      if (document.activeElement !== canvas) return;
      e.preventDefault();
      attemptHit();
    }

    function onClick() {
      if (!running) return;
      attemptHit();
    }

    // --- toggle ---

    trigger.addEventListener("click", () => {
      const open = wrap.hasAttribute("hidden") === false;
      if (open) {
        // Close
        wrap.setAttribute("hidden", "");
        trigger.setAttribute("aria-expanded", "false");
        running = false;
        window.removeEventListener("keydown", onSpace);
        canvas.removeEventListener("click", onClick); // bug 2 fix
        clearPendingServeTimer();                     // bug 1 fix
      } else {
        // Open — fresh game
        wrap.removeAttribute("hidden");
        trigger.setAttribute("aria-expanded", "true");
        clearPendingServeTimer();                     // bug 1 fix (also on reopen)
        rally = 0;
        playerHasHit = false;
        flash = null;
        trail = [];
        frozen = false;
        autoServe();
        running = true;
        lastTime = 0;
        canvas.focus();
        window.addEventListener("keydown", onSpace);
        canvas.addEventListener("click", onClick);
        requestAnimationFrame(loop);
      }
    });

    canvas.tabIndex = 0;
  }
</script>
