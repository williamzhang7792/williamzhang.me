---
/**
 * BadmintonGame — timing rewrite (v1.7.4).
 *
 * Deterministic timing/reflex rally. Bot auto-serves on a fixed parabolic
 * arc; the user must time Space / click / tap to swing within a 250ms
 * hit window centered on the moment the shuttle arrives at their racket.
 * Each successful hit ramps difficulty: both flight times shrink by
 * SPEED_RAMP. Miss → DOM game-over overlay with rally count + Play Again.
 *
 * Swing animation is a symmetric bell curve so the peak (arm fully
 * raised) lines up with the moment of intent: input time for the user,
 * contact time for the bot. Bot's mid-rally returns are pre-scheduled
 * inside the user-to-bot tick so the windup is visible.
 *
 * Mobile: tap is bound to touchstart. The previous touch-hide fallback
 * is gone.
 */
---

<section id="badminton" class="badminton-section" aria-label="Badminton mini-game">
  <button
    type="button"
    class="bm-trigger link-underline"
    aria-expanded="false"
    aria-controls="bm-canvas-wrap"
    id="bm-trigger"
  >
    play a quick rally :)
  </button>

  <div id="bm-canvas-wrap" class="bm-canvas-wrap" hidden>
    <canvas id="bm-canvas" width="400" height="300" aria-label="Badminton rally game"></canvas>
    <p class="bm-help">
      <span class="bm-help-key">space</span> or <span class="bm-help-key">click</span> to hit.
    </p>
    <div id="bm-gameover" class="bm-gameover" hidden aria-live="polite">
      <p class="bm-gameover-rally">rally: <span id="bm-final-rally">0</span></p>
      <button type="button" id="bm-play-again" class="bm-play-again">play again</button>
    </div>
  </div>
</section>

<style>
  .badminton-section {
    margin: 20px 0 0 0;
  }

  /* Short laptop viewports: tighter top margin to help fit page above fold. */
  @media (min-width: 721px) and (max-height: 880px) {
    .badminton-section {
      margin-top: 12px;
    }
  }

  .bm-trigger {
    background: none;
    border: none;
    font-family: var(--font-script);
    font-size: 22px;
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0;
    line-height: 1;
    font-style: italic;
  }

  .bm-trigger:hover,
  .bm-trigger:focus-visible {
    color: var(--accent);
    outline: none;
  }

  .bm-canvas-wrap {
    position: relative;
    margin-top: 18px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  #bm-canvas {
    background-color: var(--bg-paper);
    border: 1px solid var(--border-subtle);
    border-radius: 2px;
    max-width: 100%;
    height: auto;
    outline: none;
    cursor: crosshair;
    touch-action: manipulation;
  }

  #bm-canvas:focus-visible {
    border-color: var(--accent);
  }

  .bm-help {
    margin: 0;
    font-family: var(--font-script);
    font-size: 17px;
    color: var(--text-muted);
    font-style: italic;
  }

  .bm-help-key {
    font-family: var(--font-mono);
    font-size: 12px;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    color: var(--accent);
    padding: 1px 6px;
    border-radius: 2px;
    font-style: normal;
  }

  .bm-gameover {
    position: absolute;
    inset: 0 0 auto 0;
    /* Match the canvas footprint, not the wrap (which also contains help text). */
    height: 300px;
    max-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    background: color-mix(in srgb, var(--bg-paper) 92%, transparent);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    border-radius: 2px;
  }

  .bm-gameover[hidden] {
    display: none;
  }

  .bm-gameover-rally {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 28px;
    font-weight: 500;
    color: var(--accent);
    margin: 0;
  }

  .bm-play-again {
    font-family: var(--font-script);
    font-size: 22px;
    font-style: italic;
    background: none;
    border: none;
    color: var(--accent);
    cursor: pointer;
    padding: 4px 0;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    line-height: 1;
  }

  .bm-play-again:hover,
  .bm-play-again:focus-visible {
    border-bottom-color: var(--accent);
    outline: none;
  }

  @media (max-width: 720px) {
    #bm-canvas {
      width: 100%;
      max-width: 360px;
    }
    .bm-gameover {
      width: 100%;
      max-width: 360px;
    }
  }
</style>

<script>
  type Pt = { x: number; y: number };
  type Phase = "bot-to-user" | "user-to-bot";

  const trigger     = document.getElementById("bm-trigger");
  const wrap        = document.getElementById("bm-canvas-wrap");
  const canvas      = document.getElementById("bm-canvas") as HTMLCanvasElement | null;
  const overlayEl   = document.getElementById("bm-gameover");
  const finalRallyEl = document.getElementById("bm-final-rally");
  const playAgainEl = document.getElementById("bm-play-again");

  if (trigger && wrap && canvas && overlayEl && finalRallyEl && playAgainEl) {
    const ctx = canvas.getContext("2d")!;
    const W = canvas.width;
    const H = canvas.height;

    // ---------- CONFIG ----------
    const SWING_COOLDOWN_MS    = 500;
    const HIT_WINDOW_MS        = 250;
    const BOT_TO_USER_FLIGHT_MS = 1100;
    const USER_TO_BOT_FLIGHT_MS = 1000;
    const SPEED_RAMP           = 0.97;
    const SWING_ANIM_MS        = 150;
    const PEAK_HEIGHT_PX       = 80;   // arc apex above linear midpoint; clears net comfortably
    const POST_MISS_TAIL_MS    = 80;   // visual tail after window closes before rally end

    // ---------- geometry ----------
    const NET_X = W / 2;
    const FLOOR_Y = H - 20;
    const PLAYER_X = 60;
    const CPU_X    = W - 60;
    const SHOULDER_Y = FLOOR_Y - 18;
    const IDLE_ARM_ANGLE  = -Math.PI / 3.5;   // arm pointing up-and-out
    const SWING_ARM_ANGLE = -Math.PI / 1.9;   // arm fully raised on peak swing
    // Racket head positions (idle pose) — used as arc endpoints.
    const userRacket: Pt = {
      x: PLAYER_X + Math.cos(IDLE_ARM_ANGLE) * 16,
      y: SHOULDER_Y + Math.sin(IDLE_ARM_ANGLE) * 16,
    };
    const botRacket: Pt = {
      x: CPU_X    - Math.cos(IDLE_ARM_ANGLE) * 16,
      y: SHOULDER_Y + Math.sin(IDLE_ARM_ANGLE) * 16,
    };

    // ---------- theme colors (sourced from CSS custom properties) ----------
    const css = getComputedStyle(document.documentElement);
    const COLOR = {
      body:   css.getPropertyValue("--text-body").trim()     || "#1c1c1c",
      muted:  css.getPropertyValue("--text-muted").trim()    || "#9a9a98",
      accent: css.getPropertyValue("--accent").trim()        || "#7a0e20",
      paper:  css.getPropertyValue("--bg-paper").trim()      || "#f5eddd",
    } as const;

    // ---------- state ----------
    let phase: Phase = "bot-to-user";
    let phaseStartTime = 0;
    let phaseDuration  = BOT_TO_USER_FLIGHT_MS;
    let rally = 0;
    let lastSwingTime  = -Infinity;
    let userSwingStart = -Infinity;
    let botSwingStart  = -Infinity;
    let gameOver = false;
    let running  = false;
    let hiddenStart = 0;

    // Caveat / Cormorant may still be loading; warm up.
    document.fonts?.ready?.catch(() => {});

    // ---------- helpers ----------

    function arcPos(start: Pt, endPt: Pt, t: number): Pt {
      const x = start.x + (endPt.x - start.x) * t;
      const yLinear = start.y + (endPt.y - start.y) * t;
      const yArc = -PEAK_HEIGHT_PX * 4 * t * (1 - t);
      return { x, y: yLinear + yArc };
    }

    /**
     * Bell curve, peaks at t = 0.5 with value 1.0. Returns 0 outside the
     * animation window. Convention: caller sets swingStart = peakTime
     * - SWING_ANIM_MS / 2 so the peak lines up with the intended moment.
     */
    function swingFor(start: number, now: number): number {
      const elapsed = now - start;
      if (elapsed < 0 || elapsed > SWING_ANIM_MS) return 0;
      const t = elapsed / SWING_ANIM_MS;
      return 4 * t * (1 - t);
    }

    function currentArc(): { start: Pt; endPt: Pt } {
      return phase === "bot-to-user"
        ? { start: botRacket,  endPt: userRacket }
        : { start: userRacket, endPt: botRacket  };
    }

    /** Rotation that keeps the cork (shuttle's +y axis in local coords) pointing in direction of motion. */
    function shuttleRot(start: Pt, endPt: Pt, t: number): number {
      const dx = endPt.x - start.x;
      const dy = (endPt.y - start.y) - PEAK_HEIGHT_PX * 4 * (1 - 2 * t);
      return Math.atan2(-dx, dy);
    }

    // ---------- game flow ----------

    function startPhase(p: Phase) {
      phase = p;
      phaseStartTime = performance.now();
      phaseDuration = (p === "bot-to-user" ? BOT_TO_USER_FLIGHT_MS : USER_TO_BOT_FLIGHT_MS)
                    * Math.pow(SPEED_RAMP, rally);
      // Bot swing for mid-rally returns is pre-scheduled in tick during
      // the outgoing user-to-bot phase. The first serve (open / Play
      // Again) is set up by startGame() below.
    }

    function startGame() {
      rally = 0;
      gameOver = false;
      overlayEl!.setAttribute("hidden", "");
      finalRallyEl!.textContent = "0";
      lastSwingTime  = -Infinity;
      userSwingStart = -Infinity;
      startPhase("bot-to-user");
      // First-serve bot swing: peak at phase start (when shuttle leaves
      // the bot's racket). The wind-up half of the bell curve technically
      // starts 75ms before phase start — invisible since the loop hasn't
      // begun rendering yet — so the visible motion is the peak-to-idle
      // follow-through, which reads as "bot just struck the bird."
      botSwingStart = phaseStartTime - SWING_ANIM_MS / 2;
      canvas!.focus();
    }

    function endRally() {
      gameOver = true;
      finalRallyEl!.textContent = String(rally);
      overlayEl!.removeAttribute("hidden");
      playAgainEl!.focus();
    }

    function attemptSwing() {
      if (!running || gameOver) return;
      const now = performance.now();
      if (now - lastSwingTime < SWING_COOLDOWN_MS) return; // silent ignore (no animation)
      lastSwingTime = now;
      userSwingStart = now - SWING_ANIM_MS / 2;            // bell-curve peak at input time

      if (phase !== "bot-to-user") return;                 // not the user's turn — animation only
      const elapsed = now - phaseStartTime;
      const inWindow = Math.abs(elapsed - phaseDuration) <= HIT_WINDOW_MS / 2;
      if (!inWindow) return;                               // out of window — animation only

      rally++;
      startPhase("user-to-bot");
    }

    // ---------- tick ----------

    function tick(now: number) {
      if (gameOver) return;
      const elapsed = now - phaseStartTime;
      const t = elapsed / phaseDuration;

      if (phase === "user-to-bot") {
        // Bot swing scheduling: peak (start + SWING_ANIM_MS / 2) lines
        // up with contact at t = 1. Fires once per phase via the
        // `botSwingStart < phaseStartTime` guard.
        if (botSwingStart < phaseStartTime
            && elapsed > phaseDuration - SWING_ANIM_MS / 2) {
          botSwingStart = now;
        }
        if (t >= 1) {
          startPhase("bot-to-user");                       // bot auto-hits and serves back
          return;
        }
      } else {
        // bot-to-user: rally ends if shuttle passes user without a hit.
        if (elapsed > phaseDuration + HIT_WINDOW_MS / 2 + POST_MISS_TAIL_MS) {
          endRally();
        }
      }
    }

    // ---------- drawing ----------

    function drawCourtLine() {
      ctx.save();
      ctx.strokeStyle = COLOR.muted;
      ctx.lineWidth = 0.6;
      const xStart = W * 0.15;
      const xEnd = W * 0.85;
      const y = FLOOR_Y;
      ctx.beginPath();
      ctx.moveTo(xStart, y + (Math.random() - 0.5) * 0.4);
      for (let x = xStart + 8; x <= xEnd; x += 8) {
        ctx.lineTo(x, y + (Math.random() - 0.5) * 0.6);
      }
      ctx.stroke();
      ctx.restore();
    }

    function drawNet() {
      ctx.save();
      ctx.strokeStyle = COLOR.muted;
      ctx.lineWidth = 0.8;
      const top = FLOOR_Y - 64;
      const bot = FLOOR_Y - 4;
      for (let i = 0; i < 3; i++) {
        const nx = NET_X + (i - 1) * 1.4 + (Math.random() - 0.5) * 0.6;
        ctx.beginPath();
        ctx.moveTo(nx, top + i * 0.8);
        ctx.lineTo(nx + (Math.random() - 0.5) * 1.0, bot - i * 0.6);
        ctx.stroke();
      }
      ctx.restore();
    }

    function drawStickFigure(x: number, label: string | null, swing: number) {
      const baseY = FLOOR_Y;
      ctx.save();
      ctx.strokeStyle = COLOR.body;
      ctx.fillStyle = COLOR.body;
      ctx.lineWidth = 1.4;
      ctx.lineCap = "round";

      // head
      ctx.beginPath();
      ctx.arc(x, baseY - 26, 4, 0, Math.PI * 2);
      ctx.fill();

      // body
      ctx.beginPath();
      ctx.moveTo(x, baseY - 22);
      ctx.lineTo(x, baseY - 8);
      ctx.stroke();

      // legs (slight V stance)
      ctx.beginPath();
      ctx.moveTo(x, baseY - 8);
      ctx.lineTo(x - 4, baseY);
      ctx.moveTo(x, baseY - 8);
      ctx.lineTo(x + 4, baseY);
      ctx.stroke();

      // racket arm — angle pivots up on swing (mirrored for the bot).
      const isBot = label !== null;
      const idleA  = isBot ? Math.PI - IDLE_ARM_ANGLE  : IDLE_ARM_ANGLE;
      const swingA = isBot ? Math.PI - SWING_ARM_ANGLE : SWING_ARM_ANGLE;
      const armAngle = idleA + (swingA - idleA) * swing;
      const handX = x + Math.cos(armAngle) * 10;
      const handY = SHOULDER_Y + Math.sin(armAngle) * 10;
      ctx.beginPath();
      ctx.moveTo(x, SHOULDER_Y);
      ctx.lineTo(handX, handY);
      // racket head — short stroke past the hand
      ctx.moveTo(handX, handY);
      ctx.lineTo(handX + Math.cos(armAngle) * 6, handY + Math.sin(armAngle) * 6);
      ctx.stroke();

      if (label) {
        ctx.fillStyle = COLOR.accent;
        ctx.font = "600 italic 16px Caveat, cursive";
        ctx.textAlign = "center";
        ctx.textBaseline = "alphabetic";
        ctx.fillText(label, x, baseY - 36);
      }
      ctx.restore();
    }

    function drawShuttle(now: number) {
      const { start, endPt } = currentArc();
      const elapsed = now - phaseStartTime;
      const t = Math.max(0, elapsed / phaseDuration);
      const pos = arcPos(start, endPt, t);
      const rot = shuttleRot(start, endPt, t);

      ctx.save();
      ctx.translate(pos.x, pos.y);
      ctx.rotate(rot);
      ctx.strokeStyle = COLOR.body;
      ctx.lineWidth = 1.2;
      ctx.lineCap = "round";
      ctx.lineJoin = "round";
      ctx.beginPath();
      // feathers fanning up from cork at +y (cork = forward in flight)
      for (let i = -2; i <= 2; i++) {
        ctx.moveTo(0, 4);
        ctx.lineTo(i * 2.4, -7);
      }
      ctx.stroke();
      ctx.fillStyle = COLOR.accent;
      ctx.beginPath();
      ctx.ellipse(0, 5, 2.6, 1.6, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    function drawCounter() {
      ctx.save();
      ctx.fillStyle = COLOR.accent;
      ctx.font = "500 italic 19px Caveat, cursive";
      ctx.textBaseline = "top";
      ctx.textAlign = "left";
      ctx.fillText(`rally: ${rally}`, 14, 12);
      ctx.restore();
    }

    function draw(now: number) {
      ctx.clearRect(0, 0, W, H);
      drawCourtLine();
      drawNet();
      drawShuttle(now);
      drawStickFigure(PLAYER_X, null, swingFor(userSwingStart, now));
      drawStickFigure(CPU_X,    "W",  swingFor(botSwingStart,  now));
      drawCounter();
    }

    function loop(now: number) {
      if (!running) return;
      tick(now);
      draw(now);
      requestAnimationFrame(loop);
    }

    // ---------- input ----------

    function onSpace(e: KeyboardEvent) {
      if (!running) return;
      if (e.code !== "Space" && e.key !== " ") return;
      if (document.activeElement !== canvas) return;
      e.preventDefault();
      attemptSwing();
    }

    function onClick() {
      attemptSwing();
    }

    function onTouchStart(e: TouchEvent) {
      e.preventDefault();
      attemptSwing();
    }

    // ---------- visibility (tab-away handling) ----------

    function onVisibilityChange() {
      if (!running || gameOver) return;
      if (document.hidden) {
        hiddenStart = performance.now();
      } else {
        const offset = performance.now() - hiddenStart;
        phaseStartTime += offset;
        if (lastSwingTime  > -Infinity) lastSwingTime  += offset;
        if (userSwingStart > -Infinity) userSwingStart += offset;
        if (botSwingStart  > -Infinity) botSwingStart  += offset;
      }
    }

    // ---------- toggle + Play Again ----------

    playAgainEl.addEventListener("click", (e) => {
      e.stopPropagation();
      startGame();
    });

    trigger.addEventListener("click", () => {
      const isOpen = wrap.hasAttribute("hidden") === false;
      if (isOpen) {
        // Close
        wrap.setAttribute("hidden", "");
        trigger.setAttribute("aria-expanded", "false");
        running = false;
        gameOver = false;
        overlayEl.setAttribute("hidden", "");
        window.removeEventListener("keydown", onSpace);
        canvas.removeEventListener("click", onClick);
        canvas.removeEventListener("touchstart", onTouchStart);
        document.removeEventListener("visibilitychange", onVisibilityChange);
      } else {
        // Open — fresh game
        wrap.removeAttribute("hidden");
        trigger.setAttribute("aria-expanded", "true");
        running = true;
        window.addEventListener("keydown", onSpace);
        canvas.addEventListener("click", onClick);
        canvas.addEventListener("touchstart", onTouchStart, { passive: false });
        document.addEventListener("visibilitychange", onVisibilityChange);
        startGame();
        requestAnimationFrame(loop);
      }
    });

    canvas.tabIndex = 0;
  }
</script>
