---
/**
 * Signature — placeholder "W. Zhang" in Caveat with a left-to-right reveal
 * animation, plus a separate flourish path that draws via stroke-dashoffset.
 *
 * Animates on every page load (no safeStorage gate, per v1.1). Total ~1.8s.
 *
 * REPLACE within 30 days: swap the inner <text> for a hand-traced single-path
 * <path d="..."> of your real signature. The reveal animation will still work;
 * the flourish path gives the satisfying ink-drawn feel even before that.
 *
 * Honors prefers-reduced-motion via the global rule + per-element overrides.
 */
---

<div class="signature-wrap" aria-hidden="true">
  <svg
    class="signature"
    viewBox="0 0 240 80"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="William Zhang signature"
  >
    <defs>
      <clipPath id="sig-reveal-clip">
        <rect class="sig-reveal-rect" x="0" y="0" width="240" height="80" />
      </clipPath>
    </defs>

    <!-- The text gets revealed left-to-right via the clipPath. -->
    <g clip-path="url(#sig-reveal-clip)">
      <text
        class="sig-text"
        x="2"
        y="50"
        font-family="Caveat, cursive"
        font-size="54"
        font-weight="600"
        fill="currentColor"
        letter-spacing="0.5"
      >W. Zhang</text>
    </g>

    <!-- Flourish underline draws via stroke-dashoffset, staggered after the
         text reveal nearly completes. -->
    <path
      class="sig-flourish"
      d="M 4 66 Q 60 72 156 62 T 220 64"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
    />
  </svg>
</div>

<style>
  .signature-wrap {
    color: var(--accent);
    line-height: 1;
  }

  .signature {
    width: 170px;
    height: auto;
    display: block;
    overflow: visible;
  }

  /* Default state: fully revealed + flourish fully drawn. Signature is
     STATIC on every page that isn't the about page (notes index, individual
     notes). The animation only runs when body.about-page is set. */
  .sig-reveal-rect {
    transform-box: fill-box;
    transform-origin: left center;
    transform: scaleX(1);
  }

  .sig-flourish {
    stroke-dasharray: 240;
    stroke-dashoffset: 0;
  }

  /* About page only: flip defaults to "unwritten" and run the animation.
     Multi-stop keyframes simulate handwritten pacing with intentional
     dwells at letter boundaries (after W, transitioning Z→h). 200ms
     initial delay so the page paints first and the signature begins
     drawing as if the document is now being signed. */
  body.about-page .sig-reveal-rect {
    transform: scaleX(0);
    animation: sig-reveal 2s linear 200ms forwards;
  }

  body.about-page .sig-flourish {
    stroke-dashoffset: 240;
    animation: sig-draw 0.85s cubic-bezier(0.55, 0.05, 0.4, 1) 1.7s forwards;
  }

  @keyframes sig-reveal {
    0%   { transform: scaleX(0); }
    3%   { transform: scaleX(0.04); }   /* pen touches paper, brief settle */
    22%  { transform: scaleX(0.20); }   /* W finished — wide capital */
    28%  { transform: scaleX(0.22); }   /* dwell: pen lifts to dot the period */
    34%  { transform: scaleX(0.31); }   /* period + space crossed */
    60%  { transform: scaleX(0.52); }   /* Z (capital) drawn */
    66%  { transform: scaleX(0.55); }   /* slight slowdown into lowercase h */
    100% { transform: scaleX(1); }      /* "hang" flows continuously */
  }

  @keyframes sig-draw {
    to { stroke-dashoffset: 0; }
  }

  @media (max-width: 720px) {
    .signature {
      width: 132px;
    }
  }

  /* Reduced motion: skip the about-page animation, jump to final state. */
  @media (prefers-reduced-motion: reduce) {
    body.about-page .sig-reveal-rect {
      transform: scaleX(1);
      animation: none;
    }
    body.about-page .sig-flourish {
      stroke-dashoffset: 0;
      animation: none;
    }
  }
</style>
