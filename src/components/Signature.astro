---
/**
 * Signature — "W. Zhang" as three fast pen gestures (SVG paths, no font):
 * a swashed W, a flicked period, and "Zhang" written as ONE continuous
 * stroke — cursive Z diving below the baseline, rising into the h's looped
 * ascender, a/n degrading into quick bumps, g's descender looping and
 * sweeping right-to-left into the full underline. That one-gesture flow is
 * what makes it read as a signature rather than handwriting.
 *
 * Writes itself on the about page via pathLength="100" + stroke-dashoffset,
 * deliberately paced (~3.9s) like watching the document get signed. Static
 * (fully drawn) on every other page.
 *
 * Honors prefers-reduced-motion: jumps straight to the finished signature.
 */
---

<div class="signature-wrap" aria-hidden="true">
  <svg
    class="signature"
    viewBox="0 0 240 80"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="William Zhang signature"
    fill="none"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path
      class="sig-stroke sig-w"
      pathLength="100"
      stroke-width="2.6"
      d="M 3 26 C 5 18 8 13 11 12.5 C 13.5 20 15.5 36 17.5 51 C 19.5 42 24 27 29 19 C 31 27 33 41 35.5 51.5 C 38.5 40 43.5 22 48.5 12 C 50 9.5 53 10.5 54.5 14.5"
    />
    <path
      class="sig-stroke sig-flick"
      pathLength="100"
      stroke-width="3"
      d="M 61 48 L 63.3 50.5"
    />
    <path
      class="sig-stroke sig-zhang"
      pathLength="100"
      stroke-width="2.1"
      d="M 66 17.5 C 69.5 13.5 75.5 11.8 81.5 12.6 C 86.5 13.3 90.5 14.6 93 16 C 86 25.5 78.5 35.5 72 44.5 C 69.5 48.5 69 53.5 71.8 56.5 C 74.6 59.4 78.8 58.2 81 54 C 85.5 45 91.5 29.5 98.5 20.5 C 100 17.2 102.6 15.8 104.1 17.4 C 105.6 19.2 104.8 23.2 103 27.6 C 101.5 33.8 100.9 44 101.2 51.5 C 101.5 45.5 104.2 39.6 108.7 38.2 C 112.4 37 115 39 115.4 42.2 C 115.8 45.6 116.8 49.2 118.6 51.4 C 121 45.8 125 40 130 38.6 C 126.1 39.2 123.1 42 122.9 45.3 C 122.7 48.7 125.7 51.3 129.9 50.5 C 132.9 49.9 134.7 47.2 135.2 43.4 C 135.9 47.3 137 50.3 139 51.4 C 141.5 45.8 145.3 40 150.3 38.8 C 153.9 37.6 156.4 39.7 156.8 42.9 C 157.2 46.1 158 49.3 159.7 51.4 C 162 45.8 165.8 40 171 38.7 C 166.9 39.3 163.7 42 163.5 45.3 C 163.3 48.7 166.3 51.3 170.5 50.6 C 173.7 50 175.7 47 176.4 42.8 C 177.7 50.5 179.1 60.5 177.5 66 C 176.2 70.8 170.7 72 166.9 69 C 164.5 67.1 164.9 63.9 167.9 62 C 161.5 64.6 151.5 65.6 139.5 64.9 C 119.5 63.7 93.5 62.6 69.5 62.8 C 46 63 26 63.9 14.5 65.2 C 11.4 65.6 9.6 66.4 8.9 67.4"
    />
  </svg>
</div>

<style>
  .signature-wrap {
    color: var(--accent);
    line-height: 1;
  }

  .signature {
    width: 170px;
    height: auto;
    display: block;
    overflow: visible;
  }

  /* Default state everywhere: fully drawn. The write-on only runs on the
     about page, deliberately slow — the document is being signed, not
     stamped. Gaps between strokes are the pen lifting. */
  body.about-page .sig-stroke {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: sig-write var(--dur) var(--ease, ease-in-out) var(--delay) forwards;
  }

  .sig-w     { --dur: 0.7s;  --delay: 0.25s; }
  .sig-flick { --dur: 0.1s;  --delay: 1.15s; }
  .sig-zhang { --dur: 2.4s;  --delay: 1.5s; }

  @keyframes sig-write {
    to { stroke-dashoffset: 0; }
  }

  @media (max-width: 720px) {
    .signature {
      width: 132px;
    }
  }

  /* Reduced motion: skip the write-on, show the finished signature. */
  @media (prefers-reduced-motion: reduce) {
    body.about-page .sig-stroke {
      stroke-dashoffset: 0;
      animation: none;
    }
  }
</style>
