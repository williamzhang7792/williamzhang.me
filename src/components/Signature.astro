---
/**
 * Signature — placeholder "W. Zhang" in Caveat with a left-to-right reveal
 * animation, plus a separate flourish path that draws via stroke-dashoffset.
 *
 * Animates on every page load (no safeStorage gate, per v1.1). Total ~1.8s.
 *
 * REPLACE within 30 days: swap the inner <text> for a hand-traced single-path
 * <path d="..."> of your real signature. The reveal animation will still work;
 * the flourish path gives the satisfying ink-drawn feel even before that.
 *
 * Honors prefers-reduced-motion via the global rule + per-element overrides.
 */
---

<div class="signature-wrap" aria-hidden="true">
  <svg
    class="signature"
    viewBox="0 0 240 80"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="William Zhang signature"
  >
    <defs>
      <clipPath id="sig-reveal-clip">
        <rect class="sig-reveal-rect" x="0" y="0" width="240" height="80" />
      </clipPath>
    </defs>

    <!-- The text gets revealed left-to-right via the clipPath. -->
    <g clip-path="url(#sig-reveal-clip)">
      <text
        class="sig-text"
        x="2"
        y="50"
        font-family="Caveat, cursive"
        font-size="54"
        font-weight="600"
        fill="currentColor"
        letter-spacing="0.5"
      >W. Zhang</text>
    </g>

    <!-- Flourish underline draws via stroke-dashoffset, staggered after the
         text reveal nearly completes. -->
    <path
      class="sig-flourish"
      d="M 4 66 Q 60 72 156 62 T 220 64"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
    />
  </svg>
</div>

<style>
  .signature-wrap {
    color: var(--accent);
    line-height: 1;
  }

  .signature {
    width: 170px;
    height: auto;
    display: block;
    overflow: visible;
  }

  /* Reveal rect — starts at scaleX(0) (text fully clipped), animates to
     scaleX(1) (text fully visible). transform-box:fill-box anchors the
     transform-origin to the rect itself, not the SVG bounding box. */
  .sig-reveal-rect {
    transform-box: fill-box;
    transform-origin: left center;
    transform: scaleX(0);
    animation: sig-reveal 1.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes sig-reveal {
    to { transform: scaleX(1); }
  }

  /* Flourish — stroke-dashoffset animation. dasharray approximates path length. */
  .sig-flourish {
    stroke-dasharray: 240;
    stroke-dashoffset: 240;
    animation: sig-draw 0.75s cubic-bezier(0.4, 0.2, 0.2, 1) 1.05s forwards;
  }

  @keyframes sig-draw {
    to { stroke-dashoffset: 0; }
  }

  @media (max-width: 720px) {
    .signature {
      width: 132px;
    }
  }

  /* Reduced motion: skip both animations, jump to final state. */
  @media (prefers-reduced-motion: reduce) {
    .sig-reveal-rect {
      transform: scaleX(1);
      animation: none;
    }
    .sig-flourish {
      stroke-dashoffset: 0;
      animation: none;
    }
  }
</style>
