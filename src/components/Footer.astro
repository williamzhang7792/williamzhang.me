---
import Signature from "~/components/Signature.astro";

export interface Props {
  hideSignature?: boolean;
  buildDate: string;
}

const { hideSignature = false, buildDate } = Astro.props;

const socials = [
  {
    label: "GitHub",
    href: "https://github.com/williamzhang7792",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/williamzhang7792/",
  },
  {
    label: "Twitter",
    href: "https://twitter.com/williamzhang7792",
  },
  {
    label: "Email",
    href: "mailto:hello@williamzhang.me",
  },
];
---

<footer class="site-footer">
  <ul class="socials" aria-label="Social links">
    {socials.map(({ label, href }) => (
      <li>
        <a
          href={href}
          class="social-link"
          aria-label={label}
          rel={href.startsWith("http") ? "noopener noreferrer" : undefined}
          target={href.startsWith("http") ? "_blank" : undefined}
        >
          {label === "GitHub" && (
            <svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
              <path d="M9 18c-4.51 2-5-2-7-2" />
            </svg>
          )}
          {label === "LinkedIn" && (
            <svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
              <rect width="4" height="12" x="2" y="9" />
              <circle cx="4" cy="4" r="2" />
            </svg>
          )}
          {label === "Twitter" && (
            <svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" fill="currentColor" stroke="none" />
            </svg>
          )}
          {label === "Email" && (
            <svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
          )}
          <span class="social-label link-underline">{label.toLowerCase()}</span>
        </a>
      </li>
    ))}
  </ul>

  {!hideSignature && (
    <div class="sign-block">
      <Signature />
      <p class="last-touched">last touched {buildDate}</p>
    </div>
  )}
</footer>

<style>
  .site-footer {
    margin-top: 24px;
    padding-top: 12px;
    border-top: 1px dashed color-mix(in srgb, var(--border-subtle) 70%, transparent);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }

  .socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    font-size: 15px;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--text-muted);
    font-style: italic;
    text-decoration: none;
    line-height: 1;
    /* Drives the inner color shift from the parent so icon + label change
       in unison with the .link-underline charging bar. */
    transition: color var(--transition-base);
  }

  .social-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    transition:
      transform 280ms cubic-bezier(0.34, 1.35, 0.64, 1),
      color var(--transition-base);
  }

  .social-label {
    line-height: 1;
  }

  .social-link:hover,
  .social-link:focus-visible {
    color: var(--accent);
    outline: none;
  }

  .social-link:hover .social-icon,
  .social-link:focus-visible .social-icon {
    transform: translateY(-1px) scale(1.08);
  }

  .sign-block {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }

  .last-touched {
    /* Right-margin pulls the timestamp inward to align with where the
       signature flourish naturally tapers off (~92% of signature width).
       Visual stack feels intentional, not box-aligned. */
    margin: 0 12px 0 0;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }

  /* Short laptop viewports: tighter footer top margin so the socials
     stay visible above the fold on the about page. */
  @media (min-width: 721px) and (max-height: 880px) {
    .site-footer {
      margin-top: 16px;
      padding-top: 8px;
    }
  }

  /* Mobile: stack socials above signature, signature stays bottom-most. */
  @media (max-width: 720px) {
    .site-footer {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 28px;
    }

    .sign-block {
      align-items: flex-start;
      align-self: flex-end;
    }

    .socials {
      gap: 14px;
      font-size: 14px;
    }
  }
</style>
